<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="hrEmployeeDialog"
        title="{i18n>SELECT_EMPLOYEE}"
        noDataText="{i18n>NO_EMPLOYEES}"
        search=".onHrSearch"
        confirm=".onHrConfirm"
        growing="true"
        items="{hrUsers>/users}">
        <StandardListItem
            title="{hrUsers>label}"
            description="{hrUsers>userId}"
            type="Active"/>
    </SelectDialog>
</core:FragmentDefinition>
