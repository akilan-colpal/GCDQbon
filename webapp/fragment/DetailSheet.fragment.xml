<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page id="detailPage" backgroundDesign="Solid" enableScrolling="true" class="sapUiResponsiveContentPadding">
        <customHeader>
            <Toolbar height="auto">
                <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween">
                    <VBox class="sapUiTinyMarginTopBottom sapUiTinyMarginEnd">
                        <layoutData>
                            <FlexItemData shrinkFactor="1" minWidth="0"/>
                        </layoutData>
                        <Label text="{= ${mDetailModel>/searchCriteria/year} + ' · ' + ${mDetailModel>/searchCriteria/quarter} }"/>
                        <Title text="{mDetailModel>/data/VarPayTemplateName}" level="H1" titleStyle="H3" wrapping="true"/>
                    </VBox>
                    <HBox alignItems="Center">
                        <layoutData>
                            <FlexItemData shrinkFactor="0"/>
                        </layoutData>
                        <Button
                            text="{i18n>GENERATE_PDF}"
                            type="Emphasized"
                            icon="sap-icon://pdf-attachment"
                            enabled="{= !!${mDetailModel>/data/global_id} &amp;&amp; !${mDetailModel>/pdfLoading} }"
                            press=".onGeneratePress"
                            class="sapUiTinyMarginEnd"/>
                        <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>CLOSE}" press=".onCloseDetail"/>
                    </HBox>
                </HBox>
            </Toolbar>
        </customHeader>
        <content>
            <VBox id="detailSheet" width="100%" class="sapUiSmallMarginTop">
                <!-- Period total and one pill per plan segment. -->
                <VBox class="qbBrandSurface qbHero" width="100%">
                    <Title text="{i18n>PERIOD_TOTAL}" titleStyle="H4" class="qbContrastText"/>
                    <HBox alignItems="End" wrap="Wrap" class="sapUiTinyMarginTop">
                        <Title
                            class="qbContrastText qbHeroNumber sapUiTinyMarginEnd"
                            titleStyle="H1"
                            wrapping="true"
                            text="{path: 'mDetailModel>/data/totalQuarterAward', formatter: '.formatCleanNumber'}"/>
                        <Title text="{mDetailModel>/data/currency}" titleStyle="H4" class="qbContrastText"/>
                    </HBox>
                    <HBox justifyContent="Center" wrap="Wrap" width="100%" class="sapUiSmallMarginTop" items="{mChartModel>/plans}">
                        <VBox alignItems="Center" class="sapUiTinyMargin">
                            <HBox alignItems="Center" justifyContent="Center" class="qbBrandPill">
                                <Title
                                    text="{path: 'mChartModel>segmentAward', formatter: '.formatCleanNumber'}"
                                    titleStyle="H5"
                                    class="qbContrastText sapUiTinyMarginEnd"/>
                                <Text
                                    text="{mDetailModel>/data/currency}"
                                    class="qbContrastText"/>
                            </HBox>
                            <Text
                                text="{= ${mChartModel>periodDays} + (${mChartModel>planType} ? ' · ' + ${mChartModel>planType} : '') }"
                                textAlign="Center"
                                class="qbContrastText sapUiTinyMarginTop"
                                wrapping="true"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Bonusable earnings: headline amount, quarterly target amount, then plan accordions. -->
                <Panel width="100%" class="qbLiftCard sapUiMediumMarginTop">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>BONUSABLE_EARNINGS}" level="H4"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="End" wrap="Wrap" class="sapUiSmallMarginBottom">
                            <Title
                                class="qbHeroNumber sapUiTinyMarginEnd"
                                titleStyle="H1"
                                text="{path: 'mChartModel>/earnings/bonusableQuarterEarn', formatter: '.formatCleanNumber'}"/>
                            <Title text="{mDetailModel>/data/currency}" titleStyle="H4"/>
                        </HBox>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                            <Title text="{i18n>QUARTERLY_TARGET}" titleStyle="H6"/>
                            <Title text="{ path: 'mChartModel>/earnings/quarterTargetPercent', formatter: '.formatPercent' }" titleStyle="H5"/>
                        </HBox>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                            <HBox alignItems="Center">
                                <Title text="{i18n>QUARTERLY_TARGET_AMOUNT}" titleStyle="H6" class="sapUiTinyMarginEnd"/>
                                <ToggleButton
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    tooltip="{i18n>QUARTERLY_TARGET_AMOUNT}"
                                    pressed="{mChartModel>/earnings/showCalc}"/>
                            </HBox>
                            <ObjectNumber
                                inverted="true"
                                state="Information"
                                number="{path: 'mChartModel>/earnings/quarterTargetAmount', formatter: '.formatCleanNumber'}"
                                unit="{mDetailModel>/data/currency}"/>
                        </HBox>
                        <HBox
                            visible="{= !!${mChartModel>/earnings/showCalc} }"
                            class="qbFormula sapUiSmallMarginTop"
                            alignItems="Center"
                            justifyContent="Center"
                            wrap="Wrap">
                            <VBox alignItems="Center" class="sapUiTinyMargin">
                                <ObjectNumber
                                    emphasized="true"
                                    number="{path: 'mChartModel>/earnings/bonusableQuarterEarn', formatter: '.formatCleanNumber'}"
                                    unit="{mDetailModel>/data/currency}"/>
                                <Label text="{i18n>BONUSABLE_EARNINGS}" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <Title text="×" titleStyle="H5" class="sapUiTinyMargin"/>
                            <VBox alignItems="Center" class="sapUiTinyMargin">
                                <Title text="{path: 'mChartModel>/earnings/quarterTargetPercent', formatter: '.formatPercent'}" titleStyle="H5"/>
                                <Label text="{i18n>QUARTERLY_TARGET_PERCENT}" class="sapUiTinyMarginTop"/>
                            </VBox>
                            <HBox alignItems="Center">
                                <Title text="=" titleStyle="H5" class="sapUiTinyMarginEnd"/>
                                <VBox alignItems="Center" class="qbFormulaResult">
                                    <ObjectNumber
                                        emphasized="true"
                                        number="{path: 'mChartModel>/earnings/quarterTargetAmount', formatter: '.formatCleanNumber'}"
                                        unit="{mDetailModel>/data/currency}"/>
                                    <Label text="{i18n>OVERALL_TARGET_AMOUNT}" class="sapUiTinyMarginTop"/>
                                </VBox>
                            </HBox>
                        </HBox>
                    </content>
                </Panel>

                <!-- PlanType accordions: each contains proration and its KPIs. -->
                <Panel width="100%" class="qbLiftCard sapUiMediumMarginTop">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>PLAN_TYPE}" level="H4"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <IconTabBar expandable="false" backgroundDesign="Transparent" items="{mChartModel>/plans}">
                            <items>
                                <IconTabFilter text="{mChartModel>periodDays}">
                                    <HBox height="2.5rem" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop" visible="{= !!${mChartModel>planType} }">
                                        <Title text="{i18n>PLAN_TYPE}" titleStyle="H6"/>
                                        <Title text="{mChartModel>planType}" titleStyle="H5"/>
                                    </HBox>

                                    <HBox height="2.5rem" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <Title text="{i18n>SEGMENT_AWARD}" titleStyle="H6"/>
                                        <ObjectNumber
                                            inverted="true"
                                            state="Information"
                                            number="{path: 'mChartModel>segmentAward', formatter: '.formatCleanNumber'}"
                                            unit="{mDetailModel>/data/currency}"/>
                                    </HBox>

                                    <HBox height="2.5rem" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <Title text="{i18n>PRORATION_PERCENT}" titleStyle="H6"/>
                                        <Title text="{ path: 'mChartModel>prorationPercent', formatter: '.formatPercent' }" titleStyle="H5"/>
                                    </HBox>

                                    <HBox height="2.5rem" justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <HBox alignItems="Center">
                                            <Title text="{i18n>PRORATED_TARGET_AMOUNT}" titleStyle="H6" class="sapUiTinyMarginEnd"/>
                                            <ToggleButton
                                                icon="sap-icon://hint"
                                                type="Transparent"
                                                tooltip="{i18n>PRORATED_TARGET_AMOUNT}"
                                                pressed="{mChartModel>showCalc}"/>
                                        </HBox>
                                        <ObjectNumber
                                            inverted="true"
                                            state="Information"
                                            number="{path: 'mChartModel>proratedTarget', formatter: '.formatCleanNumber'}"
                                            unit="{mDetailModel>/data/currency}"/>
                                    </HBox>
                                    <HBox
                                        visible="{= !!${mChartModel>showCalc} }"
                                        class="qbFormula sapUiSmallMarginTop"
                                        alignItems="Center"
                                        justifyContent="Center"
                                        wrap="Wrap">
                                        <VBox alignItems="Center" class="sapUiTinyMargin">
                                            <ObjectNumber
                                                emphasized="true"
                                                number="{path: 'mChartModel>/earnings/quarterTargetAmount', formatter: '.formatCleanNumber'}"
                                                unit="{mDetailModel>/data/currency}"/>
                                            <Label text="{i18n>QUARTERLY_TARGET_AMOUNT}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <Title text="×" titleStyle="H5" class="sapUiTinyMargin"/>
                                        <VBox alignItems="Center" class="sapUiTinyMargin">
                                            <Title text="{path: 'mChartModel>prorationPercent', formatter: '.formatPercent'}" titleStyle="H5"/>
                                            <Label text="{i18n>PRORATION_PERCENT}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <HBox alignItems="Center">
                                            <Title text="=" titleStyle="H5" class="sapUiTinyMarginEnd"/>
                                            <VBox alignItems="Center" class="qbFormulaResult">
                                                <ObjectNumber
                                                    emphasized="true"
                                                    number="{path: 'mChartModel>proratedTarget', formatter: '.formatCleanNumber'}"
                                                    unit="{mDetailModel>/data/currency}"/>
                                                <Label text="{i18n>PRORATED_TARGET_AMOUNT}" class="sapUiTinyMarginTop"/>
                                            </VBox>
                                        </HBox>
                                    </HBox>

                                    <core:Fragment fragmentName="adobeform.fragment.KpiDetail" type="XML"/>
                                </IconTabFilter>
                            </items>
                        </IconTabBar>
                    </content>
                </Panel>

                <layout:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true" class="sapUiMediumMarginTop" width="100%">
                    <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" class="sapUiTinyMargin"/>
                </layout:Grid>
                <Title text="{i18n>NOTE_GCD_BONUS_PRETAX}" level="H6" textAlign="Center" width="100%" class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
            </VBox>
        </content>
    </Page>
</core:FragmentDefinition>
