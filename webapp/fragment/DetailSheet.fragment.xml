<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:microchart="sap.suite.ui.microchart">
    <Dialog
        id="detailDialog"
        class="qbSlideOver"
        showHeader="false"
        contentWidth="75%"
        contentHeight="100%"
        horizontalScrolling="false"
        verticalScrolling="false"
        stretch="{device>/system/phone}"
        core:require="{
            Decimal: 'sap/ui/model/odata/type/Decimal',
            Formatter: 'adobeform/model/formatter'
        }">
        <content>
            <Page id="detailPage" height="100%" showHeader="false" backgroundDesign="Solid">
        <content>
            <HBox class="qbDetailToolbar" justifyContent="SpaceBetween" alignItems="Center" width="100%" wrap="Wrap">
                <VBox class="sapUiSmallMarginBegin">
                    <Label text="{= ${mStatementModel>/searchCriteria/year} + ' · ' + ${mStatementModel>/searchCriteria/quarter} }"/>
                    <Title text="{mStatementModel>/data/VarPayTemplateName}" level="H3" wrapping="false"/>
                </VBox>
                <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                    <Button
                        text="{i18n>GENERATE_PDF}"
                        type="Emphasized"
                        icon="sap-icon://pdf-attachment"
                        enabled="{= !!${mStatementModel>/data/global_id} &amp;&amp; !${mStatementModel>/pdfLoading} }"
                        press=".onGeneratePress"
                        class="sapUiTinyMarginEnd"/>
                    <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>CLOSE}" press=".onCloseDetail"/>
                </HBox>
            </HBox>
            <VBox class="qbDetailBody sapUiSmallMargin" width="auto">
                <VBox class="qbBrandSurface qbHero">
                    <Title text="{i18n>PERIOD_TOTAL}" titleStyle="H5" class="qbOnBrand"/>
                    <HBox alignItems="End" wrap="Wrap" class="sapUiTinyMarginTop qbHeroAmount">
                        <Title
                            class="qbOnBrand qbHeroNumber sapUiTinyMarginEnd"
                            titleStyle="H1"
                            text="{
                                path: 'mStatementModel>/data/totalQuarterAward',
                                type: 'Decimal',
                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                            }"/>
                        <Title text="{mStatementModel>/data/currency}" titleStyle="H3" class="qbOnBrand qbHeroCurrency"/>
                    </HBox>
                    <HBox justifyContent="Center" wrap="Wrap" class="sapUiMediumMarginTop" items="{mStatementModel>/data/to_KPIs}">
                        <VBox alignItems="Center" width="13rem" class="qbKpiPill">
                            <HBox alignItems="Center" justifyContent="Center" class="qbBrandPill">
                                <ObjectNumber
                                    class="qbOnBrand"
                                    emphasized="true"
                                    number="{
                                        path: 'mStatementModel>kpiPayout',
                                        type: 'Decimal',
                                        formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                        constraints: { scale: 'variable', nullable: true, precision: 20 }
                                    }"
                                    unit="{mStatementModel>/data/currency}"/>
                            </HBox>
                            <Text text="{mStatementModel>KPIName}" textAlign="Center" class="qbOnBrand sapUiTinyMarginTop" wrapping="true"/>
                        </VBox>
                    </HBox>
                </VBox>

                <Panel width="auto" class="qbLiftCard sapUiMediumMarginTop">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>BONUSABLE_EARNINGS}" level="H4"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <HBox alignItems="End" wrap="Wrap" class="sapUiSmallMarginBottom qbHeroAmount">
                            <Title
                                class="qbHeroNumber sapUiTinyMarginEnd"
                                titleStyle="H1"
                                text="{
                                    path: 'mStatementModel>/data/bonusableEarnings',
                                    type: 'Decimal',
                                    formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                    constraints: { scale: 'variable', nullable: true, precision: 20 }
                                }"/>
                            <Title text="{mStatementModel>/data/currency}" titleStyle="H4" class="qbHeroCurrency"/>
                        </HBox>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginTop">
                            <Label text="{i18n>QUARTERLY_TARGET}" class="qbDetailLabel"/>
                            <Title text="{ path: 'mStatementModel>/data/summary/quarterTargetPercent', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                        </HBox>

                        <Panel expandable="true" expanded="true" width="auto" class="qbSubPanel sapUiSmallMarginTop">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>QUARTERLY_TARGET_AMOUNT}" level="H6"/>
                                    <ToolbarSpacer/>
                                    <ObjectNumber
                                        inverted="true"
                                        state="Information"
                                        number="{
                                            path: 'mStatementModel>/data/summary/quarterTargetAmount',
                                            type: 'Decimal',
                                            formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                            constraints: { scale: 'variable', nullable: true, precision: 20 }
                                        }"
                                        unit="{mStatementModel>/data/currency}"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <content>
                                <HBox class="qbFormula" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <ObjectNumber
                                            class="qbDetailValue"
                                            emphasized="true"
                                            number="{
                                                path: 'mStatementModel>/data/bonusableEarnings',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                            }"
                                            unit="{mStatementModel>/data/currency}"/>
                                        <Label text="{i18n>BONUSABLE_EARNINGS}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="×" titleStyle="H5" class="sapUiTinyMargin"/>
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{ path: 'mStatementModel>/data/summary/quarterTargetPercent', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                                        <Label text="{i18n>QUARTERLY_TARGET_PERCENT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="=" titleStyle="H5" class="sapUiTinyMargin"/>
                                    <VBox alignItems="Center" class="qbFormulaResult">
                                        <layoutData>
                                            <FlexItemData growFactor="1" baseSize="30%" minWidth="10rem"/>
                                        </layoutData>
                                        <ObjectNumber
                                            class="qbDetailValue"
                                            emphasized="true"
                                            number="{
                                                path: 'mStatementModel>/data/summary/quarterTargetAmount',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                            }"
                                            unit="{mStatementModel>/data/currency}"/>
                                        <Label text="{i18n>OVERALL_TARGET_AMOUNT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                </HBox>
                            </content>
                        </Panel>

                        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginTop">
                            <Label text="{i18n>PRORATION_PERCENT}" class="qbDetailLabel"/>
                            <Title text="{ path: 'mStatementModel>/data/summary/paymentPeriod', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                        </HBox>

                        <Panel expandable="true" expanded="true" width="auto" class="qbSubPanel sapUiSmallMarginTop">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>PRORATED_TARGET_AMOUNT}" level="H6"/>
                                    <ToolbarSpacer/>
                                    <ObjectNumber
                                        inverted="true"
                                        state="Information"
                                        number="{
                                            path: 'mStatementModel>/data/proratedTargetAmount',
                                            type: 'Decimal',
                                            formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                            constraints: { scale: 'variable', nullable: true, precision: 20 }
                                        }"
                                        unit="{mStatementModel>/data/currency}"/>
                                </OverflowToolbar>
                            </headerToolbar>
                            <content>
                                <HBox class="qbFormula" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <ObjectNumber
                                            class="qbDetailValue"
                                            emphasized="true"
                                            number="{
                                                path: 'mStatementModel>/data/summary/quarterTargetAmount',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                            }"
                                            unit="{mStatementModel>/data/currency}"/>
                                        <Label text="{i18n>QUARTERLY_TARGET_AMOUNT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="×" titleStyle="H5" class="sapUiTinyMargin"/>
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{ path: 'mStatementModel>/data/summary/paymentPeriod', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                                        <Label text="{i18n>PRORATION_PERCENT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="=" titleStyle="H5" class="sapUiTinyMargin"/>
                                    <VBox alignItems="Center" class="qbFormulaResult">
                                        <layoutData>
                                            <FlexItemData growFactor="1" baseSize="30%" minWidth="10rem"/>
                                        </layoutData>
                                        <ObjectNumber
                                            class="qbDetailValue"
                                            emphasized="true"
                                            number="{
                                                path: 'mStatementModel>/data/proratedTargetAmount',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                            }"
                                            unit="{mStatementModel>/data/currency}"/>
                                        <Label text="{i18n>PRORATED_TARGET_AMOUNT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                    </VBox>
                                </HBox>
                            </content>
                        </Panel>
                    </content>
                </Panel>

                <Panel width="auto" class="qbLiftCard sapUiMediumMarginTop">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>KPI_DETAILS}" level="H4"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <Text
                            text="{i18n>NO_KPIS}"
                            visible="{= !${mStatementModel>/data/to_KPIs} || ${mStatementModel>/data/to_KPIs}.length === 0 }"/>
                        <VBox items="{mStatementModel>/data/to_KPIs}">
                            <Panel expandable="true" expanded="true" width="auto" class="qbSubPanel sapUiSmallMarginBottom">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{mStatementModel>KPIName}" level="H5" wrapping="true"/>
                                        <ToolbarSpacer/>
                                        <ObjectNumber
                                            inverted="true"
                                            state="Information"
                                            number="{
                                                path: 'mStatementModel>kpiPayout',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                            }"
                                            unit="{mStatementModel>/data/currency}"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <content>
                                    <layout:Grid defaultSpan="XL6 L6 M12 S12" containerQuery="true" width="100%">
                                        <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                            <HBox class="qbFormula sapUiSmallMarginBottom" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                                <VBox class="sapUiTinyMargin">
                                                    <ObjectNumber
                                                        class="qbDetailValue"
                                                        emphasized="true"
                                                        number="{
                                                            path: 'mStatementModel>proratedTarget',
                                                            type: 'Decimal',
                                                            formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                            constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                        }"
                                                        unit="{mStatementModel>/data/currency}"/>
                                                    <Label text="{i18n>PRORATED_TARGET}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                                </VBox>
                                                <Title text="×" titleStyle="H5"/>
                                                <VBox alignItems="End" class="sapUiTinyMargin">
                                                    <Title text="{ path: 'mStatementModel>kpiWeight', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                                                    <Label text="{i18n>KPI_WEIGHT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                                </VBox>
                                            </HBox>
                                            <HBox class="qbFormula sapUiSmallMarginBottom" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                                <VBox class="sapUiTinyMargin">
                                                    <ObjectNumber
                                                        class="qbDetailValue"
                                                        emphasized="true"
                                                        number="{
                                                            path: 'mStatementModel>kpiTargetAmount',
                                                            type: 'Decimal',
                                                            formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                            constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                        }"
                                                        unit="{mStatementModel>/data/currency}"/>
                                                    <Label text="{i18n>TARGET_AMOUNT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                                </VBox>
                                                <Title text="×" titleStyle="H5"/>
                                                <VBox alignItems="End" class="sapUiTinyMargin">
                                                    <Title text="{ path: 'mStatementModel>kpiPayoutPercent', formatter: 'Formatter.formatPercent' }" titleStyle="H5"/>
                                                    <Label text="{i18n>ACHIEVEMENT}" class="qbDetailLabel sapUiTinyMarginTop"/>
                                                </VBox>
                                            </HBox>
                                            <HBox class="qbFormulaResult" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                                                <Title text="{i18n>MY_KPI_PAYOUT}" titleStyle="H5" class="sapUiTinyMarginEnd"/>
                                                <ObjectNumber
                                                    class="qbDetailValue"
                                                    emphasized="true"
                                                    state="Information"
                                                    number="{
                                                        path: 'mStatementModel>kpiPayout',
                                                        type: 'Decimal',
                                                        formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                        constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                    }"
                                                    unit="{mStatementModel>/data/currency}"/>
                                            </HBox>
                                        </VBox>
                                        <VBox class="sapUiSmallMarginBottom">
                                            <Table inset="false" width="100%" fixedLayout="false">
                                                <columns>
                                                    <Column width="8rem"><Text text=""/></Column>
                                                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                                        <Text text="{i18n>KPI_RESULT}"/>
                                                    </Column>
                                                    <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                                        <Text text="{i18n>PAYOUT_PERCENT}"/>
                                                    </Column>
                                                    <Column hAlign="End">
                                                        <Text text="{i18n>AMOUNT}"/>
                                                    </Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem>
                                                        <cells>
                                                            <Text text="{i18n>TARGET}"/>
                                                            <Text text="{
                                                                path: 'mStatementModel>kpiResTarget',
                                                                type: 'Decimal',
                                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                            }"/>
                                                            <Text text="100%"/>
                                                            <Text text="{
                                                                path: 'mStatementModel>kpiTargetAmount',
                                                                type: 'Decimal',
                                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                            }"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                    <ColumnListItem class="qbAchievementRow" highlight="Information">
                                                        <cells>
                                                            <Text text="{i18n>ACHIEVEMENT}"/>
                                                            <Text text="{
                                                                path: 'mStatementModel>kpiResAchievement',
                                                                type: 'Decimal',
                                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                            }"/>
                                                            <Text text="{ path: 'mStatementModel>kpiPayoutPercent', formatter: 'Formatter.formatPercent' }"/>
                                                            <Text text="{
                                                                path: 'mStatementModel>kpiPayout',
                                                                type: 'Decimal',
                                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                                constraints: { scale: 'variable', nullable: true, precision: 20 }
                                                            }"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                            <microchart:LineMicroChart
                                                class="sapUiSmallMarginTop"
                                                size="Responsive"
                                                width="100%"
                                                height="8rem"
                                                showPoints="true"
                                                threshold="100"
                                                showThresholdLine="true"
                                                leftTopLabel="0%"
                                                rightTopLabel="{ path: 'mStatementModel>kpiPayoutPercent', formatter: 'Formatter.formatPercent' }"
                                                points="{mStatementModel>chartPoints}">
                                                <microchart:points>
                                                    <microchart:LineMicroChartPoint x="{mStatementModel>x}" y="{mStatementModel>y}"/>
                                                </microchart:points>
                                            </microchart:LineMicroChart>
                                        </VBox>
                                    </layout:Grid>
                                </content>
                            </Panel>
                        </VBox>
                    </content>
                </Panel>

                <layout:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true" class="sapUiMediumMarginTop" width="100%">
                    <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" class="sapUiTinyMargin"/>
                    <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" class="sapUiTinyMargin"/>
                </layout:Grid>
                <Title text="{i18n>NOTE_GCD_BONUS_PRETAX}" level="H6" textAlign="Center" width="100%" class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>
            </VBox>
        </content>
            </Page>
        </content>
    </Dialog>
</core:FragmentDefinition>
