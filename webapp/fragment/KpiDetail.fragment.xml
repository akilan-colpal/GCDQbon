<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Panel width="100%" backgroundDesign="Transparent" class="sapUiSmallMarginTop sapUiNoContentPadding">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>KPI_DETAILS}" level="H4"/>
            </OverflowToolbar>
        </headerToolbar>
        <content>
            <Text
                text="{i18n>NO_KPIS}"
                class="sapUiSmallMarginTop"
                visible="{= !${mChartModel>kpis} || ${mChartModel>kpis}.length === 0 }"/>
            <VBox width="100%" items="{path: 'mChartModel>kpis', templateShareable: false}">
                <Panel
                    expandable="true"
                    expanded="false"
                    width="100%"
                    backgroundDesign="Transparent"
                    class="sapUiSmallMarginBottom sapUiNoContentPadding">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{mChartModel>KPIName}" level="H6"/>
                            <ToolbarSpacer/>
                            <ObjectNumber
                                inverted="true"
                                state="Information"
                                number="{path: 'mChartModel>kpiPayout', formatter: '.formatCleanNumber'}"
                                unit="{mDetailModel>/data/currency}"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <content>
                        <layout:Grid defaultSpan="XL6 L6 M6 S12" containerQuery="true" width="100%" class="sapUiSmallMarginTop">
                            <VBox class="qbKpiCol sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <HBox class="qbFormula sapUiMediumMarginBottom" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                    <VBox class="sapUiTinyMargin">
                                        <ObjectNumber
                                            emphasized="true"
                                            number="{path: 'mChartModel>proratedTarget', formatter: '.formatCleanNumber'}"
                                            unit="{mDetailModel>/data/currency}"/>
                                        <Label text="{i18n>PRORATED_TARGET}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="×" titleStyle="H5"/>
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{ path: 'mChartModel>kpiWeight', formatter: '.formatPercent' }" titleStyle="H5"/>
                                        <Label text="{i18n>KPI_WEIGHT}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="×" titleStyle="H5"/>
                                    <VBox alignItems="End" class="sapUiTinyMargin">
                                        <Title text="{ path: 'mChartModel>teamWeight', formatter: '.formatPercent' }" titleStyle="H5"/>
                                        <Label text="{i18n>TEAM_WEIGHT}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="=" titleStyle="H5"/>
                                </HBox>
                                <HBox class="qbFormula sapUiMediumMarginBottom" alignItems="Center" justifyContent="Center" wrap="Wrap">
                                    <VBox alignItems="Center" class="qbFormulaResult">
                                        <ObjectNumber
                                            emphasized="true"
                                            number="{path: 'mChartModel>kpiTargetAmount', formatter: '.formatCleanNumber'}"
                                            unit="{mDetailModel>/data/currency}"/>
                                        <Label text="{i18n>TARGET_AMOUNT}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                    <Title text="×" titleStyle="H5" class="sapUiLargeMarginBeginEnd"/>
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{ path: 'mChartModel>kpiPayoutPercent', formatter: '.formatPercent' }" titleStyle="H5"/>
                                        <Label text="{i18n>KPI_PAYOUT_PERCENT}" class="sapUiTinyMarginTop"/>
                                    </VBox>
                                </HBox>
                                <HBox class="qbFormulaResult" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" width="100%">
                                    <Title text="{i18n>MY_KPI_PAYOUT}" titleStyle="H5" class="sapUiTinyMarginEnd"/>
                                    <ObjectNumber
                                        emphasized="true"
                                        state="Information"
                                        number="{path: 'mChartModel>kpiPayout', formatter: '.formatCleanNumber'}"
                                        unit="{mDetailModel>/data/currency}"/>
                                </HBox>
                            </VBox>
                            <VBox class="sapUiSmallMarginBottom">
                                <Table inset="false" width="100%" fixedLayout="false">
                                    <columns>
                                        <Column><Text text=""/></Column>
                                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                            <Text text="{= ${i18n>KPI_RESULT} + (${mDetailModel>/data/currency} ? ' (' + ${mDetailModel>/data/currency} + ')' : '') }"/>
                                        </Column>
                                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                            <Text text="{i18n>PAYOUT_PERCENT}"/>
                                        </Column>
                                        <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline">
                                            <Text text="{= ${i18n>AMOUNT} + (${mDetailModel>/data/currency} ? ' (' + ${mDetailModel>/data/currency} + ')' : '') }"/>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{i18n>THRESHOLD}"/>
                                                <Text text="{path: 'mChartModel>kpiResThreshold', formatter: '.formatCleanNumber'}"/>
                                                <Text text="{path: 'mChartModel>kpiThresholdPercent', formatter: '.formatPercent'}"/>
                                                <Text text="{path: 'mChartModel>kpiThresholdAmount', formatter: '.formatCleanNumber'}"/>
                                            </cells>
                                        </ColumnListItem>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{i18n>TARGET}"/>
                                                <Text text="{path: 'mChartModel>kpiResTarget', formatter: '.formatCleanNumber'}"/>
                                                <Text text="100%"/>
                                                <Text text="{path: 'mChartModel>kpiTargetAmount', formatter: '.formatCleanNumber'}"/>
                                            </cells>
                                        </ColumnListItem>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{i18n>MAX_PAYOUT}"/>
                                                <Text text="{path: 'mChartModel>kpiResMaxPayout', formatter: '.formatCleanNumber'}"/>
                                                <Text text="{path: 'mChartModel>kpiMaxPayoutPercent', formatter: '.formatPercent'}"/>
                                                <Text text="{path: 'mChartModel>kpiMaxPayoutAmount', formatter: '.formatCleanNumber'}"/>
                                            </cells>
                                        </ColumnListItem>
                                        <ColumnListItem class="qbAchievementRow" highlight="Information">
                                            <cells>
                                                <Text text="{i18n>ACHIEVEMENT}"/>
                                                <Text text="{path: 'mChartModel>kpiResAchievement', formatter: '.formatCleanNumber'}"/>
                                                <Text text="{ path: 'mChartModel>kpiPayoutPercent', formatter: '.formatPercent' }"/>
                                                <Text text="{path: 'mChartModel>kpiPayout', formatter: '.formatCleanNumber'}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                                <viz:VizFrame
                                    vizType="area"
                                    width="100%"
                                    height="16rem"
                                    vizProperties="{mChartModel>vizProperties}"
                                    class="sapUiTinyMarginTop">
                                    <viz:dataset>
                                        <viz.data:FlattenedDataset data="{path: 'mChartModel>chartPoints', templateShareable: true}">
                                            <viz.data:dimensions>
                                                <viz.data:DimensionDefinition
                                                    name="KPI result"
                                                    value="{mChartModel>label}"/>
                                            </viz.data:dimensions>
                                            <viz.data:measures>
                                                <viz.data:MeasureDefinition
                                                    name="Payout %"
                                                    value="{mChartModel>payoutPercent}"/>
                                            </viz.data:measures>
                                        </viz.data:FlattenedDataset>
                                    </viz:dataset>
                                    <viz:feeds>
                                        <viz.feeds:FeedItem
                                            uid="valueAxis"
                                            type="Measure"
                                            values="Payout %"/>
                                        <viz.feeds:FeedItem
                                            uid="categoryAxis"
                                            type="Dimension"
                                            values="KPI result"/>
                                    </viz:feeds>
                                </viz:VizFrame>
                            </VBox>
                        </layout:Grid>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Panel>
</core:FragmentDefinition>
