<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog 
        id="treeDialog" 
        title="Select Employee" 
        contentWidth="40em" 
        contentHeight="40em">
        
        <content>
            <Tree 
                id="orgTree"
                mode="SingleSelectMaster"
                itemPress=".onTreeItemPress"
                items="{
                    path: 'treeModel>/treeHierarchy',
                    parameters: { arrayNames: ['nodes'] }
                }">
                <StandardTreeItem 
                    title="{treeModel>firstname} {treeModel>lastname} ({treeModel>empid})"
                    type="Active" />
            </Tree>
        </content>

        <endButton>
            <Button text="Cancel" press=".onCloseTreeDialog" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>