<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="treeDialog"
        title="{i18n>SELECT_EMPLOYEE}"
        contentWidth="40rem"
        contentHeight="32rem">
        <content>
            <VBox class="sapUiSmallMargin">
                <SearchField
                    placeholder="{i18n>FILTER_TREE}"
                    liveChange=".onManagerTreeSearch"
                    search=".onManagerTreeSearch"
                    width="100%"/>
                <Text text="{i18n>CLICK_ROW}" class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
                <Tree
                    id="orgTree"
                    mode="SingleSelectMaster"
                    includeItemInSelection="true"
                    itemPress=".onTreeItemPress"
                    width="100%"
                    noDataText="{i18n>NO_MATCHING_PEOPLE}"
                    items="{
                        path: 'treeFilter>/nodes',
                        parameters: { arrayNames: ['nodes'], numberOfExpandedLevels: 1 }
                    }">
                    <StandardTreeItem title="{treeFilter>title}" type="Active"/>
                </Tree>
            </VBox>
        </content>
        <endButton>
            <Button text="{i18n>CANCEL}" press=".onCloseTreeDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
