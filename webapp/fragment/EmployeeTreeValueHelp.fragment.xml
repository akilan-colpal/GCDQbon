<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog 
        id="treeDialog" 
        title="Select Employee" 
        contentWidth="50em" 
        contentHeight="40em"
        horizontalScrolling="false"
        verticalScrolling="true"
        class="sapUiContentPadding"> 

        <customHeader>
            <Toolbar height="3rem">
                <Title text="Select Employee" level="H3" class="sapUiTinyMarginBegin" />
            </Toolbar>
        </customHeader>

        <content>
            <VBox width="100%">
                <SearchField 
                    placeholder="Search by Name or ID..."
                    liveChange=".onManagerTreeSearch"
                    search=".onManagerTreeSearch"
                    width="100%"
                    class="sapUiSmallMarginBottom" />

                <HBox class="sapUiTinyMarginBottom" alignItems="Center" justifyContent="SpaceBetween">
                    <Text text="Click a row to select." />
                </HBox>

                <HBox class="sapUiTinyMarginBottom" />

                <Tree 
                    id="orgTree"
                    mode="SingleSelectMaster"
                    includeItemInSelection="true"
                    itemPress=".onTreeItemPress"
                    toggleOpenState=".onTreeToggleOpenState"
                    width="100%"
                    items="{
                        path: 'treeModel>/treeHierarchy',
                        parameters: { arrayNames: ['nodes'] }
                    }">
                    <StandardTreeItem 
                        title="{
                            parts: [
                                'treeModel>firstname', 
                                'treeModel>lastname', 
                                'treeModel>empid'
                            ],
                            formatter: '.formatTreeTitle'
                        }"
                        type="Active" />
                </Tree>
            </VBox>
        </content>

        <endButton>
            <Button text="Cancel" press=".onCloseTreeDialog" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>