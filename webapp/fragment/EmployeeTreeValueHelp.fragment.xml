<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog 
        id="treeDialog" 
        title="Select Employee" 
        contentWidth="50em" 
        contentHeight="40em">
        <SearchField 
            placeholder="Search by Name or ID..."
            liveChange=".onManagerTreeSearch"
            search=".onManagerTreeSearch"
            width="100%"
            class="sapUiBottomMargin" />
        <content>
            <Tree 
                id="orgTree"
                mode="SingleSelectMaster"
                itemPress=".onTreeItemPress"
                toggleOpenState=".onTreeToggleOpenState"
                items="{
                    path: 'treeModel>/treeHierarchy',
                    parameters: { arrayNames: ['nodes'] }
                }">
                <StandardTreeItem 
                    title="{
                        parts: [
                            'treeModel>firstname', 
                            'treeModel>lastname', 
                            'treeModel>empid', 
                            'treeModel>_bIsDummy'
                        ],
                        formatter: '.formatTreeTitle'
                    }"
                    type="Active" />
            </Tree>
        </content>

        <endButton>
            <Button text="Cancel" press=".onCloseTreeDialog" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>