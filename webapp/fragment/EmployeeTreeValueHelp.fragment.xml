<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Manager picker. Tree data is treeModel>/treeHierarchy, copied from the view model. -->
    <Dialog
        id="treeDialog"
        title="{i18n>SELECT_EMPLOYEE}"
        contentWidth="48rem"
        contentHeight="32rem"
        horizontalScrolling="false"
        verticalScrolling="true"
        stretch="{device>/system/phone}"
        class="sapUiResponsiveContentPadding">

        <content>
            <VBox width="100%">
                <SearchField
                    placeholder="{i18n>FILTER_TREE}"
                    liveChange=".onManagerTreeSearch"
                    search=".onManagerTreeSearch"
                    width="100%"
                    class="sapUiSmallMarginBottom"/>

                <Text text="{i18n>CLICK_ROW}" class="sapUiTinyMarginBottom"/>

                <Tree
                    id="orgTree"
                    mode="SingleSelectMaster"
                    includeItemInSelection="true"
                    itemPress=".onTreeItemPress"
                    toggleOpenState=".onTreeToggleOpenState"
                    width="100%"
                    noDataText="{i18n>NO_MATCHING_PEOPLE}"
                    items="{
                        path: 'treeModel>/treeHierarchy',
                        parameters: { arrayNames: ['nodes'] }
                    }">
                    <StandardTreeItem
                        title="{
                            parts: [
                                'treeModel>firstname',
                                'treeModel>lastname',
                                'treeModel>empid'
                            ],
                            formatter: '.formatTreeTitle'
                        }"
                        type="Active"/>
                </Tree>
            </VBox>
        </content>

        <endButton>
            <Button text="{i18n>CANCEL}" press=".onCloseTreeDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
