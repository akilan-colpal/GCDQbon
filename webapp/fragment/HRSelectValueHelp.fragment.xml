<core:FragmentDefinition
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <!-- HR employee search. Columns and the User entity are bound in HRValueHelpHandler. -->
    <ValueHelpDialog
        ok=".onValueHelpOkPress"
        cancel=".onValueHelpCancelPress"
        afterClose=".onValueHelpAfterClose"
        supportMultiselect="false">

        <filterBar>
            <fb:FilterBar
                id="valueHelpFilterBar"
                advancedMode="true"
                search=".onFilterBarSearch"
                filterBarExpanded="false"
                showGoOnFB="true"
                showClearOnFB="true">
            </fb:FilterBar>
        </filterBar>

    </ValueHelpDialog>

</core:FragmentDefinition>
