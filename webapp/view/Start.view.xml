<mvc:View
    controllerName="adobeform.controller.Start"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!--
        Start. Unnamed model is mQuartersModel (set in Start.controller).
        mUserDataModel comes from the component.
        sapUiResponsiveContentPadding follows Device.media screen size.
    -->
    <Page
        id="page"
        showHeader="false"
        backgroundDesign="Transparent"
        class="sapUiResponsiveContentPadding">
        <content>
            <VBox width="100%">
                <VBox class="qbBrandSurface qbHero qbStartHero" width="100%">
                    <VBox class="qbStartContent">
                        <Title
                            text="{i18n>MY_BONUS_AMOUNT}"
                            titleStyle="H1"
                            wrapping="true"
                            class="qbContrastText"/>
                        <Text
                            text="{i18n>START_SUBTITLE}"
                            class="qbContrastText sapUiTinyMarginTop sapUiSmallMarginBottom"/>


                        <VBox class="sapUiSmallMarginTop" width="100%">
                            <Label text="{i18n>GLOBAL_ID}" labelFor="employeeIdInput" class="qbContrastText sapUiTinyMarginBottom"/>
                            <Input
                                id="employeeIdInput"
                                width="100%"
                                value="{path: 'mQuartersModel>/selectedEmployeeLabel', mode: 'OneWay'}"
                                editable="{= ${mUserDataModel>/isHR} || ${mUserDataModel>/isMgr} }"
                                showValueHelp="{= ${mUserDataModel>/isHR} || ${mUserDataModel>/isMgr} }"
                                valueHelpOnly="true"
                                valueHelpRequest=".onEmployeeValueHelp"
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"/>

                            <Label text="{i18n>BONUS_YEAR}" labelFor="bonusYearInput" class="qbContrastText sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                            <Select
                                id="bonusYearInput"
                                width="100%"
                                selectedKey="{mQuartersModel>/searchCriteria/year}"
                                items="{mQuartersModel>/availableYears}"
                                change=".onYearChange"
                                forceSelection="false"
                                enabled="{mQuartersModel>/isYearEnabled}">
                                <core:Item key="{mQuartersModel>year}" text="{mQuartersModel>year}"/>
                            </Select>
                        </VBox>

                        <!-- Enabled when an employee, a year, and at least one quarter card exist. -->
                        <Button
                            id="getDetailsButton"
                            class="sapUiSmallMarginTop"
                            width="100%"
                            text="{= ${mQuartersModel>/summariesLoading} ? ${i18n>LOADING} : ${i18n>GET_DETAILS} }"
                            type="Success"
                            icon="sap-icon://navigation-right-arrow"
                            iconFirst="false"
                            enabled="{mQuartersModel>/isSearchEnabled}"
                            press=".onContinue"/>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
