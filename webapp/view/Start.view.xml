<mvc:View
    controllerName="adobeform.controller.Start"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="page" showHeader="false" backgroundDesign="Transparent">
        <content>
            <VBox class="sapUiMediumMargin" width="auto">
                <VBox class="qbBrandSurface qbHero qbStartHero">
                    <VBox class="qbStartContent">
                        <Title
                            text="{i18n>MY_BONUS_AMOUNT}"
                            titleStyle="H1"
                            wrapping="true"
                            class="qbOnBrand"/>
                        <Text
                            text="{i18n>START_SUBTITLE}"
                            class="qbOnBrand sapUiTinyMarginTop sapUiSmallMarginBottom"/>

                        <VBox class="sapUiSmallMarginTop" width="100%">
                            <Label text="{i18n>GLOBAL_ID}" labelFor="employeeIdInput" class="qbOnBrand sapUiTinyMarginBottom"/>
                            <Input
                                id="employeeIdInput"
                                width="100%"
                                value="{path: '/selectedEmployeeLabel', mode: 'OneWay'}"
                                editable="{= ${mUserDataModel>/isHR} || ${mUserDataModel>/isMgr} }"
                                showValueHelp="{= ${mUserDataModel>/isHR} || ${mUserDataModel>/isMgr} }"
                                valueHelpRequest=".onEmployeeValueHelp"
                                change=".onGlobalIdChange"
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"/>

                            <Label text="{i18n>BONUS_YEAR}" labelFor="bonusYearInput" class="qbOnBrand sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                            <Select
                                id="bonusYearInput"
                                width="100%"
                                selectedKey="{/searchCriteria/year}"
                                items="{/availableYears}"
                                change=".onYearChange"
                                forceSelection="false"
                                enabled="{/isYearEnabled}">
                                <core:Item key="{year}" text="{year}"/>
                            </Select>

                            <HBox visible="{/periodsLoading}" alignItems="Center" class="sapUiTinyMarginTop">
                                <BusyIndicator size="1.5rem"/>
                                <Text text="{i18n>LOADING_PERIODS}" class="sapUiSmallMarginBegin qbOnBrand"/>
                            </HBox>
                        </VBox>

                        <Button
                            id="getDetailsButton"
                            class="sapUiSmallMarginTop"
                            width="100%"
                            text="{= ${/periodsLoading} || ${/summariesLoading} ? ${i18n>LOADING} : ${i18n>GET_DETAILS} }"
                            type="Success"
                            icon="sap-icon://navigation-right-arrow"
                            iconFirst="false"
                            enabled="{/isSearchEnabled}"
                            press=".onContinue"/>
                    </VBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
