<mvc:View
    controllerName="adobeform.controller.gcdStatementFilter"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <f:DynamicPage id="mainPage" headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>MY_BONUS_AMOUNT}" level="H2" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader>
                <HBox wrap="Wrap">
                    <GenericTile
                        id="myBonusTile"
                        header="{i18n>MY_BONUS_AMOUNT}"
                        press=".onMyBonusAmountPress"
                        frameType="TwoByOne"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <ImageContent src="sap-icon://money-bills" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                    <GenericTile
                        id="bonusPlanTile"
                        header="{i18n>BONUS_PLAN_DOCUMENT}"
                        press=".onBonusPlanDocumentPress"
                        frameType="TwoByOne"
                        state="{= ${/isPdfButtonVisible} ? 'Loaded' : 'Disabled' }"
                        class="sapUiSmallMarginBottom">
                        <tileContent>
                            <TileContent>
                                <content>
                                    <ImageContent src="sap-icon://pdf-attachment" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </HBox>

                <HBox wrap="Wrap" visible="{/isPdfButtonVisible}" class="sapUiSmallMarginTop">
                    <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                        <Label text="{i18n>YEAR_TO_DATE_TOTAL}" />
                        <ObjectNumber
                            number="{path: '/data/totalBonusYTD', formatter: '.formatCleanNumber'}"
                            unit="{/data/currency}"
                            emphasized="true"
                            state="Success" />
                    </VBox>
                    <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                        <Label text="{i18n>QUARTER_AWARD}" />
                        <ObjectNumber
                            number="{path: '/data/totalQuarterAward', formatter: '.formatCleanNumber'}"
                            unit="{/data/currency}"
                            emphasized="true" />
                    </VBox>
                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="{i18n>BONUSABLE_EARNINGS}" />
                        <ObjectNumber
                            number="{path: '/data/bonusableEarnings', formatter: '.formatCleanNumber'}"
                            unit="{/data/currency}"
                            emphasized="true" />
                    </VBox>
                </HBox>

                <Text text="{i18n>YEAR_TO_DATE_EXPLANATION}" visible="{/isPdfButtonVisible}" />
                <ObjectAttribute
                    title="{i18n>ELIGIBILITY}"
                    text="{/data/eligibilityPeriod}"
                    visible="{/isPdfButtonVisible}" />
                <Title
                    text="{/data/VarPayTemplateName}"
                    level="H4"
                    visible="{/isPdfButtonVisible}" />

                <HBox wrap="Wrap" class="sapUiSmallMarginTop">
                    <VBox visible="{/isGlobalIdVisible}" class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                        <Label text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                        <Input
                            id="employeeIdInput"
                            placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"
                            change=".onGlobalIdChange"
                            showValueHelp="true"
                            valueHelpRequest=".onEmployeeTreeValueHelp"
                            valueHelpOnly="true"
                            width="14rem" />
                    </VBox>

                    <VBox visible="{mUserDataModel>/isHR}" class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                        <Label text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                        <Input
                            id="hrEmployeeIdInput"
                            placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"
                            showValueHelp="true"
                            valueHelpRequest=".onHREmployeeValueHelp"
                            width="14rem"
                            change=".onGlobalIdChange" />
                    </VBox>

                    <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                        <Label text="{i18n>BONUS_YEAR}" design="Bold" class="sapUiTinyMarginBottom" />
                        <Select
                            id="bonusYearInput"
                            forceSelection="false"
                            items="{/availableYears}"
                            change=".onYearChange"
                            width="14rem">
                            <core:Item key="{year}" text="{year}" />
                        </Select>
                    </VBox>

                    <VBox class="sapUiSmallMarginBottom">
                        <Label text="{i18n>BONUS_QUARTER}" design="Bold" class="sapUiTinyMarginBottom" />
                        <Select
                            id="bonusQuarterInput"
                            forceSelection="false"
                            enabled="{/isQuarterEnabled}"
                            items="{/availableQuarters}"
                            width="14rem">
                            <core:Item key="{quarter}" text="{quarter}" />
                        </Select>
                    </VBox>
                </HBox>

                <HBox justifyContent="End">
                    <Button
                        id="searchBtn"
                        text="{i18n>GET_THE_DETAILS}"
                        type="Emphasized"
                        press=".onSearchPress" />
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox width="100%">
                <IllustratedMessage
                    id="emptyState"
                    illustrationType="SearchEarth"
                    title="{i18n>NO_DATA_TITLE}"
                    description="{i18n>NO_DATA_DESCRIPTION}"
                    visible="{= !${/isPdfButtonVisible} }" />
                <mvc:XMLView
                    id="resultsView"
                    viewName="adobeform.view.gcdStatementResults"
                    async="true"
                    visible="{/isPdfButtonVisible}" />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
