<mvc:View 
    controllerName="adobeform.controller.gcdStatementFilter"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Page id="mainPage" showHeader="false" enableScrolling="false" class="splitPage">
        <content>
            <HBox id="splitShell" width="100%" height="100%" class="splitShell" renderType="Bare">

                <!-- LEFT: criteria rail -->
                <VBox id="criteriaRail" class="criteriaRail" height="100%">
                    <layoutData>
                        <FlexItemData growFactor="0" shrinkFactor="0" baseSize="20rem" minWidth="16rem" />
                    </layoutData>

                    <Panel id="mainPanel"
                           width="100%"
                           class="criteriaPanel"
                           headerText="{i18n>FILTER_CRITERIA}">

                        <VBox class="sapUiSmallMargin">
                            <!-- MANAGER VIEW -->
                            <VBox id="_IDGenVBox1" visible="{/isGlobalIdVisible}" class="sapUiSmallMarginBottom">
                                <Label id="_IDGenLabel" text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                                <Input 
                                    id="employeeIdInput" 
                                    placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}" 
                                    change=".onGlobalIdChange" 
                                    showValueHelp="true"
                                    valueHelpRequest=".onEmployeeTreeValueHelp"
                                    valueHelpOnly="true"
                                    width="100%" />
                            </VBox>

                            <!-- HR VIEW -->
                            <VBox visible="{mUserDataModel>/isHR}" class="sapUiSmallMarginBottom">
                                <Label text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                                <Input 
                                    id="hrEmployeeIdInput"
                                    placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onHREmployeeValueHelp"
                                    width="100%" 
                                    change=".onGlobalIdChange"/>
                            </VBox>

                            <VBox id="_IDGenVBox2" class="sapUiSmallMarginBottom">
                                <Label id="_IDGenLabel1" text="{i18n>BONUS_YEAR}" design="Bold" class="sapUiTinyMarginBottom" />
                                <Select id="bonusYearInput" 
                                        forceSelection="false"
                                        items="{/availableYears}" 
                                        change=".onYearChange"
                                        width="100%">
                                    <core:Item id="_IDGenItem" key="{year}" text="{year}" />
                                </Select>
                            </VBox>

                            <VBox id="_IDGenVBox3" class="sapUiSmallMarginBottom">
                                <Label id="_IDGenLabel2" text="{i18n>BONUS_QUARTER}" design="Bold" class="sapUiTinyMarginBottom" />
                                <Select id="bonusQuarterInput" 
                                        forceSelection="false"
                                        enabled="{/isQuarterEnabled}"
                                        items="{/availableQuarters}"
                                        width="100%">
                                    <core:Item id="_IDGenItem1" key="{quarter}" text="{quarter}" />
                                </Select>
                            </VBox>

                            <Button
                                id="searchBtn"
                                text="{i18n>SEARCH_RECORDS}"
                                type="Emphasized"
                                press=".onSearchPress"
                                width="100%"
                                class="sapUiSmallMarginTop" />
                        </VBox>
                    </Panel>
                </VBox>

                <!-- RIGHT: empty gradient or results -->
                <VBox id="resultsPane" class="resultsPane" height="100%" width="100%">
                    <layoutData>
                        <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                    </layoutData>

                    <VBox
                        id="emptyResultsState"
                        class="resultsEmptyState"
                        width="100%"
                        height="100%"
                        justifyContent="Center"
                        alignItems="Center"
                        visible="{= !${/isPdfButtonVisible} }">
                        <Title text="{i18n>EMPTY_RESULTS_TITLE}" level="H2" class="resultsEmptyTitle" />
                        <Text text="{i18n>EMPTY_RESULTS_DESCRIPTION}" class="resultsEmptyDescription" textAlign="Center" />
                    </VBox>

                    <ScrollContainer
                        id="resultsScroll"
                        width="100%"
                        height="100%"
                        vertical="true"
                        horizontal="false"
                        visible="{/isPdfButtonVisible}"
                        class="resultsScroll">
                        <mvc:XMLView
                            id="resultsView"
                            viewName="adobeform.view.gcdStatementResults"
                            async="true" />
                    </ScrollContainer>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
