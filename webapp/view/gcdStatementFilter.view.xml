<mvc:View 
    controllerName="adobeform.controller.gcdStatementFilter"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">
    
    <Page id="mainPage" showHeader="false" enableScrolling="true" class="startupPageBg">
        <content>
            <VBox id="_IDGenVBox" width="100%" height="100%" class="cappedAppContainer appShell">

                <HBox alignItems="Stretch" width="100%" class="startupHero" renderType="Bare">

                    <!-- Left: criteria card -->
                    <Panel id="bonusCard"
                           width="24rem"
                           class="bonusCard"
                           headerText="{i18n>MY_BONUS_AMOUNT}">

                        <VBox alignItems="Center" width="100%" class="ytdBlock sapUiMediumMarginBottom">
                            <Label text="{i18n>YEAR_TO_DATE_TOTAL}" design="Bold" />
                            <ObjectNumber
                                class="sapUiTinyMarginTop bonusYtd"
                                number="{/startup/ytdAmount}"
                                unit="{/startup/currency}"
                                />
                            <Text text="{i18n>YEAR_TO_DATE_EXPLANATION}" textAlign="Center" width="100%" class="sapUiTinyMarginTop" />
                        </VBox>

                        <!-- MANAGER VIEW -->
                        <VBox id="_IDGenVBox1" visible="{/isGlobalIdVisible}" class="sapUiMediumMarginBottom">
                            <Label id="_IDGenLabel" text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                            <Input 
                                id="employeeIdInput" 
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}" 
                                change=".onGlobalIdChange" 
                                showValueHelp="true"
                                valueHelpRequest=".onEmployeeTreeValueHelp"
                                valueHelpOnly="true"
                                width="100%" />
                        </VBox>

                        <!-- HR VIEW -->
                        <VBox visible="{mUserDataModel>/isHR}" class="sapUiMediumMarginBottom">
                            <Label text="{i18n>GLOBAL_ID}" design="Bold" class="sapUiTinyMarginBottom" />
                            <Input 
                                id="hrEmployeeIdInput"
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"
                                showValueHelp="true"
                                valueHelpRequest=".onHREmployeeValueHelp"
                                width="100%" 
                                change=".onGlobalIdChange"/>
                        </VBox>

                        <VBox id="_IDGenVBox2" class="sapUiMediumMarginBottom">
                            <Label id="_IDGenLabel1" text="{i18n>BONUS_YEAR}" design="Bold" class="sapUiTinyMarginBottom" />
                            <Select id="bonusYearInput" 
                                    forceSelection="false"
                                    items="{/availableYears}" 
                                    change=".onYearChange"
                                    width="100%">
                                <core:Item id="_IDGenItem" key="{year}" text="{year}" />
                            </Select>
                        </VBox>

                        <VBox id="_IDGenVBox3" class="sapUiMediumMarginBottom">
                            <Label id="_IDGenLabel2" text="{i18n>BONUS_QUARTER}" design="Bold" class="sapUiTinyMarginBottom" />
                            <Select id="bonusQuarterInput" 
                                    forceSelection="false"
                                    enabled="{/isQuarterEnabled}"
                                    items="{/availableQuarters}"
                                    change=".onQuarterChange"
                                    width="100%">
                                <core:Item id="_IDGenItem1" key="{quarter}" text="{quarter}" />
                            </Select>
                        </VBox>

                        <HBox justifyContent="Center" width="100%" class="sapUiSmallMarginTop">
                            <Button id="searchBtn" 
                                    text="{i18n>GET_THE_DETAILS}" 
                                    type="Accept"
                                    press=".onSearchPress" 
                                    enabled="{/isSearchEnabled}"
                                    class="detailsBtn" />
                        </HBox>
                    </Panel>

                    <!-- Right: empty state + sliding details card -->
                    <VBox id="detailsStack" width="100%" class="detailsPane">

                        <VBox alignItems="Center"
                              justifyContent="Center"
                              height="100%"
                              class="heroEmpty sapUiContentPadding">
                            <Title text="{i18n>NO_DATA_TITLE}" level="H3" />
                            <Text text="{i18n>NO_DATA_DESCRIPTION}" class="sapUiSmallMarginTop" textAlign="Center" />
                        </VBox>

                        <VBox id="detailsPanel" width="100%" height="100%" class="detailsOpen">
                            <OverflowToolbar class="detailsToolbar">
                                <Button
                                    icon="sap-icon://nav-back"
                                    type="Transparent"
                                    press=".onDetailsBack"
                                    tooltip="{i18n>GET_THE_DETAILS}" />
                                <Title text="{i18n>GET_THE_DETAILS}" level="H4" />
                                <ToolbarSpacer />
                            </OverflowToolbar>

                            <mvc:XMLView
                                id="resultsView"
                                viewName="adobeform.view.gcdStatementResults"
                                async="true" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Disclaimer -->
                <VBox class="disclaimerBand">
                    <l:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true" hSpacing="0" vSpacing="0">
                        <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" class="disclaimerText" />
                    </l:Grid>
                    <MessageStrip
                        text="{i18n>NOTE_GCD_BONUS_PRETAX}"
                        type="Information"
                        showIcon="true"
                        class="disclaimerNote" />
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
