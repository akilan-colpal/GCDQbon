<mvc:View 
    controllerName="adobeform.controller.gcdStatementFilter"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">
    
    <Page id="mainPage" showHeader="false">
        <content>
            <VBox id="_IDGenVBox" width="100%" class="startupPage">

                <HBox alignItems="Stretch" width="100%" class="startupHero">
                    <VBox id="bonusCard" class="bonusCard">
                        <Title text="{i18n>MY_BONUS_AMOUNT}" level="H3" class="bonusTitle" />

                        <VBox alignItems="Center" class="ytdBlock">
                            <Text text="{i18n>YEAR_TO_DATE_TOTAL}" textAlign="Center" class="ytdLabel" />
                            <HBox justifyContent="Center" alignItems="End" width="100%" class="ytdAmountRow">
                                <Text text="$" class="bonusDollar" />
                                <Text text="{/startup/ytdAmount}" class="bonusFigure" />
                                <Text text="{/startup/currency}" class="bonusCurrency" />
                            </HBox>
                            <Text text="{i18n>YEAR_TO_DATE_EXPLANATION}" textAlign="Center" class="ytdExplanation" />
                        </VBox>

                        <VBox id="_IDGenVBox1" visible="{/isGlobalIdVisible}" class="bonusField">
                            <Label id="_IDGenLabel" text="{i18n>GLOBAL_ID}" design="Bold" class="bonusFieldLabel" />
                            <Input 
                                id="employeeIdInput" 
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}" 
                                change=".onGlobalIdChange" 
                                showValueHelp="true"
                                valueHelpRequest=".onEmployeeTreeValueHelp"
                                valueHelpOnly="true"
                                width="100%" />
                        </VBox>

                        <VBox visible="{mUserDataModel>/isHR}" class="bonusField">
                            <Label text="{i18n>GLOBAL_ID}" design="Bold" class="bonusFieldLabel" />
                            <Input 
                                id="hrEmployeeIdInput"
                                placeholder="{i18n>GLOBAL_ID_PLACEHOLDER}"
                                showValueHelp="true"
                                valueHelpRequest=".onHREmployeeValueHelp"
                                width="100%" 
                                change=".onGlobalIdChange"/>
                        </VBox>

                        <VBox id="_IDGenVBox2" class="bonusField">
                            <Label id="_IDGenLabel1" text="{i18n>BONUS_YEAR}" design="Bold" class="bonusFieldLabel" />
                            <Select id="bonusYearInput" 
                                    forceSelection="false"
                                    items="{/availableYears}" 
                                    change=".onYearChange"
                                    width="100%">
                                <core:Item id="_IDGenItem" key="{year}" text="{year}" />
                            </Select>
                        </VBox>

                        <VBox id="_IDGenVBox3" class="bonusField">
                            <Label id="_IDGenLabel2" text="{i18n>BONUS_QUARTER}" design="Bold" class="bonusFieldLabel" />
                            <Select id="bonusQuarterInput" 
                                    forceSelection="false"
                                    enabled="{/isQuarterEnabled}"
                                    items="{/availableQuarters}"
                                    change=".onQuarterChange"
                                    width="100%">
                                <core:Item id="_IDGenItem1" key="{quarter}" text="{quarter}" />
                            </Select>
                        </VBox>

                        <HBox justifyContent="Center" width="100%" class="detailsAction">
                            <Button id="searchBtn" text="{i18n>GET_THE_DETAILS}" press=".onGetDetailsPress" enabled="{/isSearchEnabled}" class="detailsBtn" />
                        </HBox>
                    </VBox>

                    <VBox class="heroSide">
                        <VBox class="heroGradient" />
                        <VBox id="detailsStack" class="detailsStack">
                            <HBox alignItems="Center" class="detailsStackBar">
                                <Button
                                    icon="sap-icon://nav-back"
                                    type="Transparent"
                                    press=".onDetailsBack"
                                    class="detailsBackBtn"
                                    tooltip="{i18n>GET_THE_DETAILS}" />
                                <Title text="{i18n>GET_THE_DETAILS}" level="H4" class="detailsStackTitle" />
                            </HBox>
                            <mvc:XMLView
                                id="resultsView"
                                viewName="adobeform.view.gcdStatementResults"
                                async="true" />
                        </VBox>
                    </VBox>
                </HBox>

                <VBox class="disclaimerBand">
                    <l:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true">
                        <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" class="disclaimerText" />
                        <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" class="disclaimerText" />
                    </l:Grid>
                    <MessageStrip
                        text="{i18n>NOTE_GCD_BONUS_PRETAX}"
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginTop" />
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
