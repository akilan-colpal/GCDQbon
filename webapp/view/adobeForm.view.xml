<mvc:View 
    controllerName="adobeform.controller.adobeForm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table">
    
    <Page id="mainPage" showHeader="false">
        <content>
            
            <VBox id="_IDGenVBox" width="100%" class="cappedAppContainer">
                
                <!--  Filter Criteria -->
                <Panel id="mainPanel" 
                       width="auto"
                       class="sapUiResponsiveMargin"
                       headerText="Filter Criteria">
                    
                    <HBox id="_IDGenHBox" wrap="Wrap" class="sapUiSmallMarginTop sapUiSmallMarginBottom sapUiSmallMarginBegin">
                        
                        <VBox id="_IDGenVBox1" class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                            <Label id="_IDGenLabel" text="Global ID" design="Bold" class="sapUiTinyMarginBottom" />
                            <MultiInput id="globalIdInput" 
                                        placeholder="Enter Global ID" 
                                        change=".onGlobalIdChange" 
                                        width="14rem" />
                        </VBox>

                        <VBox id="_IDGenVBox2" class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
                            <Label id="_IDGenLabel1" text="Bonus Year" design="Bold" class="sapUiTinyMarginBottom" />
                            <Select id="bonusYearInput" 
                                    forceSelection="false"
                                    items="{/availableYears}" 
                                    change=".onYearChange"
                                    width="14rem">
                                <core:Item id="_IDGenItem" key="{year}" text="{year}" />
                            </Select>
                        </VBox>

                        <VBox id="_IDGenVBox3" class="sapUiSmallMarginBottom">
                            <Label id="_IDGenLabel2" text="Bonus Quarter" design="Bold" class="sapUiTinyMarginBottom" />
                            <Select id="bonusQuarterInput" 
                                    forceSelection="false"
                                    enabled="{/isQuarterEnabled}"
                                    items="{/availableQuarters}"
                                    width="14rem">
                                <core:Item id="_IDGenItem1" key="{quarter}" text="{quarter}" />
                            </Select>
                        </VBox>
                        
                    </HBox>

                    <HBox id="actionBox" justifyContent="End" class="sapUiTinyMarginBottom sapUiTinyMarginEnd">
                        <Button id="searchBtn" text="Search Records" type="Default" press=".onSearchPress" />
                    </HBox>
                </Panel>

                <!-- DATA ACCORDION -->
                <Panel id="resultsAccordion" 
                       width="auto"
                       expandable="true" 
                       expanded="true" 
                       class="sapUiNoMarginTop sapUiResponsiveMargin">
                    
                    <headerToolbar>
                        <Toolbar id="_IDGenToolbar" height="3rem">
                            <Title id="_IDGenTitle" text="{VarPayTemplateName}" level="H2" />
                            <ToolbarSpacer id="_IDGenToolbarSpacer1" /> 
                            <HBox id="custom"  class="sapUiTinyMarginEnd">
                            <Button 
                                id="generatePdfBtn" 
                                text="Generate PDF" 
                                press=".onGeneratePress" 
                                type="Emphasized" 
                                visible="false" />                           
                               </HBox>

                       </Toolbar>
                    </headerToolbar>
                    
                    <content>
                        
                        <!--  HEADER DISPLAY -->
                        <HBox id="_IDGenHBox1" wrap="Wrap" justifyContent="SpaceAround" class="sapUiSmallMargin">
                            <HBox id="_IDGenHBox3" class="sapUiTinyMarginBottom sapUiSmallMarginRight">
                                <VBox id="_IDGenVBox6" class="kpiLabelBox" justifyContent="Center">
                                    <Label id="_IDGenLabel4" text="Eligibility" />
                                </VBox>
                                <VBox id="_IDGenVBox7" class="kpiValueBox" justifyContent="Center">
                                <Label id="_IDGenText1" text="{eligibilityPeriod}"  design = "Bold" class="blackTextLabel"/>                                
                                </VBox>
                            </HBox>
                            <HBox id="_IDGenHBox4" class="sapUiTinyMarginBottom sapUiSmallMarginRight">
                                <VBox id="_IDGenVBox8" class="kpiLabelBox" justifyContent="Center">
                                    <Label id="_IDGenLabel5" text="Quarter Award" />
                                </VBox>
                                <VBox id="_IDGenVBox9" class="kpiValueBox" justifyContent="Center">
                                    <ObjectNumber id="_IDGenObjectNumber1" class="blackBoldNumber"
                                                  number="{path: 'totalQuarterAward', formatter: '.formatCleanNumber'}" 
                                                  unit="{currency}" />
                                </VBox>
                            </HBox>
                            <HBox id="_IDGenHBox5" class="sapUiTinyMarginBottom">
                                <VBox id="_IDGenVBox10" class="kpiLabelBox" justifyContent="Center">
                                    <Label id="_IDGenLabel6" text="Bonusable Earnings" />
                                </VBox>
                                <VBox id="_IDGenVBox11" class="kpiValueBox" justifyContent="Center">
                                    <ObjectNumber id="_IDGenObjectNumber2" class="blackBoldNumber"
                                                  number="{path: 'bonusableEarnings', formatter: '.formatCleanNumber'}" 
                                                  unit="{currency}" />
                                </VBox>
                            </HBox>
                        </HBox>

                    <!-- TABLES CONTAINER -->
                    <VBox id="_IDGenVBox12" alignItems="Center" width="100%" class="sapUiMediumMarginTop">
                        
                        <!-- TABLE 1: KPI DATA -->
                        <VBox id="_IDGenVBox13" width="95%" class="sapUiLargeMarginBottom">
                            <Title id="_IDGenTitle1" text="KPI Details for Current Quarter" level="H3" class="sapUiTinyMarginBottom" />
                            <table:Table id="kpiTable" 
                                        rows="{to_KPIs}" 
                                        selectionMode="None" 
                                        class="kpiTableHeader"
                                        visibleRowCount="{/kpiRowCount}"
                                        rowHeight="45">
                                <table:columns>
                                    <table:Column width="5rem">
                                        <Label text="Quarter" textAlign="Center" width="100%" />
                                        <table:template><Text text="{bonusQuarter}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column >
                                        <Label text="KPI" textAlign="Center" width="100%" />
                                        <table:template><Text text="{KPIName}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column hAlign="End" width="10rem">
                                        <Label text="KPI Result *Target" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiResTarget', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    <table:Column hAlign="End" width="10rem">
                                        <Label text="KPI Result *Achievement" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiResAchievement', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    <table:Column hAlign="End" width="11rem">
                                        <Label text="Prorated Target Amount" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'proratedTarget', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column hAlign="End" width="6rem">
                                        <Label text="KPI Weight" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiWeight', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    <table:Column hAlign="End" width="6rem">
                                        <Label text="Team Weight" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'teamWeight', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column hAlign="End" width="11rem">
                                        <Label text="KPI Target Amount" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiTargetAmount', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column hAlign="End" width="6rem">
                                        <Label text="KPI Payout %" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiPayoutPercent', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    
                                    <table:Column hAlign="End" width="10rem">
                                        <Label text="My KPI Payout" textAlign="Center" width="100%" />
                                        <table:template><Text text="{path: 'kpiPayout', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                </table:columns>
                            </table:Table>
                            
                            <HBox id="_IDGenHBox6" justifyContent="End" alignItems="Center" class="sapUiTinyMarginTop">
                                <VBox id="_IDGenVBox14" class="kpiLabelBox" justifyContent="Center">
                                    <Label id="_IDGenLabel17" text="Total KPI Payout" design="Bold" class="sapUiSmallMarginRight" />
                                </VBox>
                                <VBox id="_IDGenVBox15" class="kpiValueBox" justifyContent="Center">
                                    <ObjectNumber id="_IDGenObjectNumber3" class="blackBoldNumber"
                                                number="{path: 'totalKPIPayout', formatter: '.formatCleanNumber'}" 
                                                unit="{currency}" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- TABLE 2: SUMMARY DATA -->
                        <VBox id="_IDGenVBox16" width="95%" class="sapUiLargeMarginBottom">
                            <Title id="_IDGenTitle2" text="Quarter Plan Summary" level="H3" class="sapUiTinyMarginBottom" />
                            <table:Table id="summaryTable" 
                                        rows="{to_qSum}" 
                                        class="summaryTableHeader"
                                        selectionMode="None" 
                                        visibleRowCount="{/summaryRowCount}"
                                        rowHeight="45">
                                <table:columns>
                                    <table:Column id="_IDGenColumn10" width="8rem">
                                        <Label id="_IDGenLabel18" text="Quarter" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText12" text="{summaryQuarter}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn11" width="9rem">
                                        <Label id="_IDGenLabel19" text="Period" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText13" text="{period}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn12">
                                        <Label id="_IDGenLabel20" text="Plan Type" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText14" text="{planType}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn13" hAlign="End" width="12rem">
                                        <Label id="_IDGenLabel21" text="Bonusable Earnings" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText15" text="{path: 'bonusableQuarterEarn', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn14" hAlign="End" width="10rem">
                                        <Label id="_IDGenLabel22" text="Quarterly Target %" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText16" text="{path: 'quarterTargetPercent', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn16" width="10rem">
                                        <Label id="_IDGenLabel24" text="Payment Period" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText18" text="{paymentPeriod}" /></table:template>
                                    </table:Column>
                                    <table:Column id="_IDGenColumn15" hAlign="End" width="11rem">
                                        <Label id="_IDGenLabel23" text="Quarterly Target Amt" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText17" text="{path: 'quarterTargetAmount', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>

                                    <table:Column id="_IDGenColumn17" hAlign="End" width="10rem">
                                        <Label id="_IDGenLabel25" text="Segment Award" textAlign="Center" width="100%" />
                                        <table:template><Text id="_IDGenText19" text="{path: 'segmentAward', formatter: '.formatCleanNumber'}" /></table:template>
                                    </table:Column>
                                </table:columns>
                            </table:Table>
                                
                                <HBox id="_IDGenHBox7" justifyContent="End" alignItems="Center" class="sapUiTinyMarginTop">
                                    <VBox id="_IDGenVBox17" class="kpiLabelBox" justifyContent="Center">
                                        <Label id="_IDGenLabel26" text="Total Bonus Earned Year-to-Date" design="Bold" class="sapUiSmallMarginRight" />
                                    </VBox>
                                    <VBox id="_IDGenVBox18" class="kpiValueBox" justifyContent="Center">
                                        <ObjectNumber id="_IDGenObjectNumber4" class="blackBoldNumber"
                                                      number="{path: 'totalBonusYTD', formatter: '.formatCleanNumber'}" 
                                                      unit="{currency}" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox id="disclaimerContainer" width="95%" class="sapUiMediumMarginTop sapUiLargeMarginBottom">
                                <Table id="disclaimerTable" 
                                       showSeparators="All" 
                                       backgroundDesign="Solid" 
                                       inset="false"
                                       class="sapUiTinyMarginBottom">
                                    <columns>
                                        <Column width="25%"><Text text="" visible="false" /></Column>
                                        <Column width="25%"><Text text="" visible="false" /></Column>
                                        <Column width="25%"><Text text="" visible="false" /></Column>
                                        <Column width="25%"><Text text="" visible="false" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Top">
                                            <cells>
                                                <FormattedText class="sapUiTinyMargin" htmlText="&lt;strong&gt;&lt;em&gt;Calculation Basis:&lt;/em&gt;&lt;/strong&gt; &lt;em&gt;Your GCD Bonus award is determined by a combination of Business Performance (Sales Targets/KPIs) and your Individual contribution. The &quot;Total Payout&quot; reflects your achievement against the specific quarterly targets assigned to your role and region.&lt;/em&gt;" />
                                                
                                                <FormattedText class="sapUiTinyMargin" htmlText="&lt;strong&gt;&lt;em&gt;Eligibility &amp; Pro-ration:&lt;/em&gt;&lt;/strong&gt; &lt;em&gt;Please note that if you joined the plan mid-quarter, changed roles, or took a leave of absence (LOA), your award has been pro-rated. The calculation is based strictly on the number of active days in the eligible position during this performance period.&lt;/em&gt;" />
                                                
                                                <FormattedText class="sapUiTinyMargin" htmlText="&lt;strong&gt;&lt;em&gt;Payment Information:&lt;/em&gt;&lt;/strong&gt; &lt;em&gt;The &quot;Total Award&quot; displayed is a gross amount (pre-tax). Statutory deductions and taxes will be applied at the time of payment through your local payroll. The net amount will be reflected in your upcoming payslip according to the local payroll cycle.&lt;/em&gt;" />
                                                
                                                <FormattedText class="sapUiTinyMargin" htmlText="&lt;strong&gt;&lt;em&gt;Official Policy &amp; Disclaimer:&lt;/em&gt;&lt;/strong&gt; &lt;em&gt;This statement is for informational purposes only. In the event of any discrepancy between this statement and the official plan rules, the GCD Bonus Plan Document shall prevail. This award does not constitute a guarantee of future employment or compensation.&lt;/em&gt;" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>

                                <HBox justifyContent="Center" class="sapUiSmallMarginTop">
                                    <Title text="Note: GCD Bonus Amount is Pre-Tax (gross)" level="H6" titleStyle="H6" />
                                </HBox>

                            </VBox>
                        </VBox>
                    </content>
                </Panel>
                
            </VBox>
        </content>
    </Page>
</mvc:View>