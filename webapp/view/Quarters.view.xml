<mvc:View
    controllerName="adobeform.controller.Quarters"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards">

    <Page
        id="quartersPage"
        showHeader="false"
        backgroundDesign="Transparent"
        busy="{journey>/summariesLoading}"
        busyIndicatorDelay="0"
        core:require="{ Decimal: 'sap/ui/model/odata/type/Decimal' }">
        <content>
            <VBox class="sapUiMediumMargin" width="auto">
                <Button
                    text="{i18n>BACK}"
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press=".onBack"
                    class="sapUiSmallMarginBottom"/>

                <IllustratedMessage
                    illustrationType="sapIllus-NoData"
                    title="{i18n>NO_QUARTERS}"
                    description="{journey>/selectedEmployeeLabel}"
                    visible="{= !${journey>/summariesLoading} &amp;&amp; ${journey>/quarters}.length === 0 }"/>

                <VBox visible="{= !${journey>/summariesLoading} &amp;&amp; ${journey>/quarters}.length > 0 }">
                    <f:Card class="qbBrandSurface sapUiSmallMarginBottom" width="100%">
                        <f:content>
                            <HBox wrap="Wrap" alignItems="End" justifyContent="SpaceBetween" class="sapUiLargeMargin">
                                <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                    <Title text="{journey>/year}" titleStyle="H1" class="qbOnBrand"/>
                                    <Title text="{i18n>PICK_QUARTER}" titleStyle="H4" class="qbOnBrand sapUiTinyMarginTop"/>
                                    <Text text="{journey>/selectedEmployeeLabel}" class="qbOnBrand sapUiSmallMarginTop"/>
                                </VBox>
                                <VBox alignItems="End" class="sapUiSmallMarginBottom">
                                    <Label text="{i18n>YEAR_TO_DATE}" class="qbOnBrand"/>
                                    <ObjectNumber
                                        class="qbOnBrand"
                                        emphasized="true"
                                        number="{
                                            path: 'journey>/ytdAmount',
                                            type: 'Decimal',
                                            formatOptions: {
                                                maxFractionDigits: 2,
                                                minFractionDigits: 0,
                                                groupingEnabled: true,
                                                parseEmptyValueToZero: true
                                            },
                                            constraints: {
                                                scale: 'variable',
                                                nullable: false,
                                                precision: 20
                                            }
                                        }"
                                        unit="{journey>/currency}"/>
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <Text text="{i18n>QUARTERS_SUBTITLE}" class="sapUiSmallMarginBottom"/>

                    <f:GridContainer
                        id="quarterGrid"
                        containerQuery="true"
                        snapToRow="true"
                        items="{path: 'journey>/quarterCards'}">
                        <f:layout>
                            <f:GridContainerSettings
                                gap="1rem"
                                minColumnSize="16rem"
                                maxColumnSize="24rem"
                                rowSize="4.5rem"/>
                        </f:layout>
                        <f:layoutS>
                            <f:GridContainerSettings
                                columns="1"
                                columnSize="100%"
                                gap="0.75rem"
                                rowSize="4.5rem"/>
                        </f:layoutS>
                        <f:Card class="qbQuarterCard">
                            <f:layoutData>
                                <f:GridContainerItemLayoutData columns="1" minRows="3"/>
                            </f:layoutData>
                            <f:header>
                                <cards:Header
                                    title="{journey>quarter}"
                                    subtitle="{journey>periodDays}"
                                    iconVisible="false"
                                    press=".onSelectQuarter"/>
                            </f:header>
                            <f:content>
                                <VBox class="sapUiMediumMargin">
                                    <ObjectNumber
                                        emphasized="true"
                                        number="{
                                            path: 'journey>totalQuarterAward',
                                            type: 'Decimal',
                                            formatOptions: {
                                                maxFractionDigits: 2,
                                                minFractionDigits: 0,
                                                groupingEnabled: true,
                                                parseEmptyValueToZero: true
                                            },
                                            constraints: {
                                                scale: 'variable',
                                                nullable: false,
                                                precision: 20
                                            }
                                        }"
                                        unit="{journey>currency}"/>
                                    <Link
                                        text="{i18n>VIEW_DETAILS}"
                                        press=".onSelectQuarter"
                                        class="sapUiSmallMarginTop"/>
                                </VBox>
                            </f:content>
                        </f:Card>
                    </f:GridContainer>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
