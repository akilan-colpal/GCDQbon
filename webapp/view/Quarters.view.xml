<mvc:View
    controllerName="adobeform.controller.Quarters"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <!--
        Quarters. Unnamed model is mQuartersModel. Detail mid-column uses mDetailModel.
        Page busy flag covers the ZI_QBON_DD reads for the year.
    -->
    <f:FlexibleColumnLayout
        id="fcl"
        layout="OneColumn"
        backgroundDesign="Transparent"
        stateChange=".onFlexColStateChange">
        <f:beginColumnPages>
            <Page
                id="quartersPage"
                showHeader="false"
                backgroundDesign="Transparent"
                class="sapUiContentPadding">
        <content>
            <VBox width="100%">
                <!-- Back to Start. Closes the detail dialog if it is open. -->
                <Button
                    text="{i18n>BACK}"
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press=".onBack"
                    class="sapUiSmallMarginBottom"/>

                <!-- Empty state when the year has no quarter cards. -->
                <IllustratedMessage
                    illustrationType="sapIllus-NoData"
                    title="{i18n>NO_QUARTERS}"
                    description="{mQuartersModel>/selectedEmployeeName}"
                    visible="{= ${mQuartersModel>/quarterCards}.length === 0 }"/>

                <!-- Year, YTD, quarter pills. -->
                <VBox
                    visible="{= ${mQuartersModel>/quarterCards}.length > 0 }"
                    width="100%">

                    <VBox class="qbBrandSurface qbHero" width="100%">
                        <Title text="{mQuartersModel>/searchCriteria/year}" titleStyle="H1" wrapping="true" class="qbContrastText"/>
                        <Title text="{i18n>PICK_QUARTER}" titleStyle="H4" wrapping="true" class="qbContrastText sapUiSmallMarginTop"/>
                        <Text text="{mQuartersModel>/selectedEmployeeName}" class="qbContrastText sapUiTinyMarginTop"/>
                        <Title text="{i18n>YEAR_TO_DATE}" titleStyle="H4" class="qbContrastText sapUiMediumMarginTop"/>
                        <HBox alignItems="End" wrap="Wrap" class="sapUiSmallMarginBottom">
                            <Title
                                class="qbContrastText qbHeroNumber sapUiTinyMarginEnd"
                                titleStyle="H1"
                                wrapping="true"
                                text="{path: 'mQuartersModel>/ytdAmount', formatter: '.formatCleanNumber'}"/>
                            <Title text="{mQuartersModel>/currency}" titleStyle="H4" class="qbContrastText"/>
                        </HBox>

                        <!-- One pill per /quarterCards row. -->
                        <List
                            id="quarterList"
                            class="sapUiSmallMarginTop"
                            width="100%"
                            backgroundDesign="Transparent"
                            items="{path: 'mQuartersModel>/quarterCards'}"
                            showSeparators="None"
                            mode="SingleSelectMaster"
                            itemPress=".onSelectQuarter">
                            <CustomListItem type="Active" class="qbQuarterPill sapUiTinyMarginBottom">
                                <HBox
                                    class="qbQuarterRow"
                                    width="100%"
                                    alignItems="Center"
                                    justifyContent="SpaceBetween">
                                    <HBox alignItems="Center">
                                        <layoutData>
                                            <FlexItemData growFactor="1" shrinkFactor="1"/>
                                        </layoutData>
                                        <Avatar
                                            src="sap-icon://money-bills"
                                            displayShape="Circle"
                                            backgroundColor="Accent6"
                                            displaySize="XS"
                                            class="sapUiTinyMarginEnd"/>
                                        <VBox>
                                            <Title text="{mQuartersModel>quarter}" titleStyle="H6"/>
                                            <Text text="{mQuartersModel>periodDays}"/>
                                        </VBox>
                                    </HBox>

                                    <HBox alignItems="Center" justifyContent="End">
                                        <layoutData>
                                            <FlexItemData growFactor="0" shrinkFactor="1"/>
                                        </layoutData>
                                        <ObjectNumber
                                            class="sapUiTinyMarginEnd sapMObjectNumberLongText"
                                            emphasized="true"
                                            number="{path: 'mQuartersModel>totalQuarterAward', formatter: '.formatCleanNumber'}"
                                            unit="{mQuartersModel>currency}"/>
                                        <core:Icon
                                            src="sap-icon://navigation-right-arrow"
                                            decorative="true"
                                            class="sapUiTinyMarginBegin"/>
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>
                </VBox>
            </VBox>
        </content>
            </Page>
        </f:beginColumnPages>
        <f:midColumnPages>
            <Page id="artPage" showHeader="false" backgroundDesign="Transparent" class="sapUiResponsiveContentPadding">
                <content>
                    <VBox class="qbQuartersArt" width="100%" height="100%"/>
                </content>
            </Page>
            <core:Fragment fragmentName="adobeform.fragment.DetailSheet" type="XML"/>
        </f:midColumnPages>
    </f:FlexibleColumnLayout>
</mvc:View>
