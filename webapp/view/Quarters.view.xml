<mvc:View
    controllerName="adobeform.controller.Quarters"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="quartersPage"
        showHeader="false"
        backgroundDesign="Transparent"
        busy="{/summariesLoading}"
        busyIndicatorDelay="0"
        core:require="{ Decimal: 'sap/ui/model/odata/type/Decimal' }">
        <content>
            <VBox class="sapUiMediumMargin" width="auto">
                <Button
                    text="{i18n>BACK}"
                    icon="sap-icon://nav-back"
                    type="Transparent"
                    press=".onBack"
                    class="sapUiSmallMarginBottom"/>

                <IllustratedMessage
                    illustrationType="sapIllus-NoData"
                    title="{i18n>NO_QUARTERS}"
                    description="{/selectedEmployeeLabel}"
                    visible="{= !${/summariesLoading} &amp;&amp; ${/quarterCards}.length === 0 }"/>

                <HBox
                    visible="{= !${/summariesLoading} &amp;&amp; ${/quarterCards}.length > 0 }"
                    wrap="Wrap"
                    alignItems="Stretch"
                    class="qbQuartersLayout">

                    <VBox class="qbBrandSurface qbHero qbQuartersPanel">
                        <Title text="{/searchCriteria/year}" titleStyle="H1" class="qbOnBrand"/>
                        <Title text="{i18n>PICK_QUARTER}" titleStyle="H4" wrapping="true" class="qbOnBrand sapUiSmallMarginTop"/>
                        <Text text="{/selectedEmployeeLabel}" class="qbOnBrand sapUiTinyMarginTop"/>
                        <Title text="{i18n>YEAR_TO_DATE}" titleStyle="H5" class="qbOnBrand sapUiMediumMarginTop"/>
                        <HBox alignItems="End" wrap="Wrap" class="qbHeroAmount sapUiSmallMarginBottom">
                            <Title
                                class="qbOnBrand qbHeroNumber sapUiTinyMarginEnd"
                                titleStyle="H1"
                                text="{
                                    path: '/ytdAmount',
                                    type: 'Decimal',
                                    formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                    constraints: { scale: 'variable', nullable: false, precision: 20 }
                                }"/>
                            <Title text="{/currency}" titleStyle="H3" class="qbOnBrand qbHeroCurrency"/>
                        </HBox>

                        <List
                            id="quarterList"
                            class="qbQuarterList sapUiSmallMarginTop"
                            width="100%"
                            items="{path: '/quarterCards'}"
                            showSeparators="None"
                            mode="None">
                            <CustomListItem type="Active" press=".onSelectQuarter" class="qbQuarterPill">
                                <HBox
                                    class="qbQuarterRow"
                                    width="100%"
                                    alignItems="Center"
                                    justifyContent="SpaceBetween"
                                    wrap="Wrap">
                                    <HBox alignItems="Center" class="qbQuarterLeft">
                                        <Avatar
                                            src="sap-icon://money-bills"
                                            displayShape="Circle"
                                            backgroundColor="Accent6"
                                            displaySize="S"
                                            class="qbQuarterBadge sapUiSmallMarginEnd"/>
                                        <VBox>
                                            <Title text="{quarter}" titleStyle="H5"/>
                                            <Text text="{periodDays}"/>
                                        </VBox>
                                    </HBox>

                                    <HBox alignItems="Center" justifyContent="End" wrap="Wrap" class="qbQuarterRight">
                                        <ObjectNumber
                                            class="sapUiSmallMarginEnd"
                                            emphasized="false"
                                            number="{
                                                path: 'totalQuarterAward',
                                                type: 'Decimal',
                                                formatOptions: { maxFractionDigits: 2, minFractionDigits: 0, groupingEnabled: true, parseEmptyValueToZero: true },
                                                constraints: { scale: 'variable', nullable: false, precision: 20 }
                                            }"
                                            unit="{currency}"/>
                                        <Button
                                            text="{i18n>VIEW_DETAILS}"
                                            icon="sap-icon://navigation-right-arrow"
                                            iconFirst="false"
                                            type="Transparent"
                                            press=".onSelectQuarter"/>
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>

                    <VBox class="qbQuartersArt"/>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
