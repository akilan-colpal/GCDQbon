<mvc:View controllerName="adobeform.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader">
                <Image
                    id="logo"
                    height="2.5rem"
                    press=".pressLogo"
                    decorative="false"
                    tooltip="{i18n>appTitle}"/>
                <VBox justifyContent="Center" class="sapUiSmallMarginBegin">
                    <Label text="{i18n>BONUS_PROGRAM}" class="qbOverline"/>
                    <Title text="{i18n>REWARDING_EXCELLENCE}" level="H4"/>
                </VBox>
                <ToolbarSpacer/>
                <Select
                    id="languageSelect"
                    selectedKey="{appSettings>/language}"
                    change=".onLanguageChange"
                    tooltip="{i18n>LANGUAGE}">
                    <core:Item key="en" text="English"/>
                    <core:Item key="es" text="Español"/>
                </Select>
                <VBox justifyContent="Center" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                    <Title text="{i18n>GREETING} {mUserDataModel>/displayName}" level="H5"/>
                    <Text text="{mUserDataModel>/title}" visible="{= ${mUserDataModel>/title} !== '' }"/>
                </VBox>
                <Avatar
                    initials="{mUserDataModel>/initials}"
                    displaySize="M"
                    backgroundColor="Accent6"/>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:mainContents>
            <VBox class="qbCanvas" width="100%">
                <App id="app" class="sapUiResponsiveContentPadding"/>
                <HBox justifyContent="Center" alignItems="Center" class="qbBrandBand">
                    <Title text="{i18n>REWARDING}" level="H3" class="sapUiTinyMarginEnd"/>
                    <Title text="{i18n>EXCELLENCE}" level="H3" class="qbAccent"/>
                </HBox>
            </VBox>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
