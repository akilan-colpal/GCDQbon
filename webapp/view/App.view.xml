<mvc:View controllerName="adobeform.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <!-- Shell. ToolPage holds the header and the routed pages. -->
    <tnt:ToolPage id="toolPage">
        <tnt:header>

            <tnt:ToolHeader id="toolHeader" class="toolHeader">
                <Image
                    id="logo"
                    src="{value: 'adobeform/image/ColPal_Icon.svg', formatter: 'sap.ui.require.toUrl'}"
                    width="auto"
                    height="8.5rem"
                    decorative="true"/>
                <VBox justifyContent="Center" class="sapUiSmallMarginBegin">
                    <Label text="{i18n>BONUS_PROGRAM}" class="qbHeaderText sapUiHideOnPhone"/>
                    <Title text="{i18n>GCD_BONUS}" level="H4" wrapping="true" class="qbHeaderText"/>
                </VBox>
                <ToolbarSpacer/>
                <!-- en / es. Writes appSettings>/language and switches the UI5 language. -->
                <Select
                    id="languageSelect"
                    selectedKey="{appSettings>/language}"
                    change=".onLanguageChange"
                    tooltip="{i18n>LANGUAGE}">
                    <core:Item key="en" text="English"/>
                    <core:Item key="es" text="Español"/>
                </Select>
                <VBox justifyContent="Center" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiHideOnPhone">
                    <Title text="{i18n>GREETING} {mUserDataModel>/displayName}" level="H5" class="qbHeaderText"/>
                    <Text text="{mUserDataModel>/title}" visible="{= ${mUserDataModel>/title} !== '' }" class="qbHeaderText"/>
                </VBox>
                <Avatar
                    initials="{mUserDataModel>/initials}"
                    displaySize="M"
                    backgroundColor="Accent6"
                    tooltip="{mUserDataModel>/displayName}"/>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:mainContents>
            <VBox class="qbCanvas" width="100%" height="100%">
                <!-- Router target. Start, Quarters, and AccessDenied render here. -->
                <App id="app" width="100%"/>
                <!-- Footer brand line. -->
                <HBox justifyContent="Center" alignItems="Center" wrap="Wrap" class="qbBrandBand" width="100%">
                    <Title text="{i18n>REWARDING}" level="H5" titleStyle="H5" class="sapUiTinyMarginEnd"/>
                    <Title text="{i18n>EXCELLENCE}" level="H5" titleStyle="H5" class="qbAccent"/>
                </HBox>
            </VBox>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
