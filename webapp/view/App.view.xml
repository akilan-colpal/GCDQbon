<mvc:View controllerName="adobeform.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <VBox id="appShell" fitContainer="true" renderType="Bare">
        <f:ShellBar id="shellBar" title="{i18n>title}" homeIconPressed=".pressLogo">
            <f:additionalContent>
                <Select id="languageSelect" change=".onLanguageChange">
                    <core:Item key="en" text="English" />
                    <core:Item key="es" text="Español" />
                </Select>
            </f:additionalContent>
        </f:ShellBar>
        <App id="app">
            <layoutData>
                <FlexItemData growFactor="1" baseSize="0%" />
            </layoutData>
        </App>
    </VBox>
</mvc:View>
