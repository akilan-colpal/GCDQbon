<mvc:View
    controllerName="adobeform.controller.gcdStatementResults"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns="sap.m">

    <VBox id="resultsRoot" width="100%" class="sapUiResponsiveMargin resultsShell" visible="{/isPdfButtonVisible}">

        <!-- ===================== AT A GLANCE ===================== -->
        <VBox class="glanceHero" width="100%">
            <HBox wrap="Wrap" alignItems="Start" justifyContent="SpaceBetween" width="100%">
                <VBox class="glanceHeroMain">
                    <Text text="{i18n>SECTION_AT_A_GLANCE}" class="glanceEyebrow" />
                    <Title text="{VarPayTemplateName}" level="H2" titleStyle="H2" class="glanceTitle" />
                    <Text text="{i18n>ELIGIBILITY}: {eligibilityPeriod}" class="glanceEligibility" />
                </VBox>
                <Button
                    id="generatePdfBtn"
                    text="{i18n>GENERATE_PDF}"
                    press=".onGeneratePress"
                    type="Emphasized"
                    class="glancePdfBtn"
                    visible="{/isPdfButtonVisible}" />
            </HBox>

            <HBox wrap="Wrap" alignItems="End" class="glanceAwardRow sapUiSmallMarginTop">
                <VBox class="glanceAwardBlock">
                    <Text text="{i18n>PERIOD_TOTAL}" class="glanceMetricLabel" />
                    <HBox alignItems="Baseline">
                        <Text text="$" class="glanceCurrency" />
                        <Text text="{path: 'totalQuarterAward', formatter: '.formatCleanNumber'}" class="glanceAwardAmount" />
                        <Text text="{currency}" class="glanceCurrency sapUiTinyMarginBegin" />
                    </HBox>
                </VBox>
            </HBox>

            <l:Grid defaultSpan="XL4 L4 M4 S12" containerQuery="true" class="glanceMetricGrid sapUiMediumMarginTop">
                <VBox class="glanceMetricTile">
                    <Text text="{i18n>BONUSABLE_EARNINGS}" class="glanceMetricLabel" />
                    <ObjectNumber
                        number="{path: 'bonusableEarnings', formatter: '.formatCleanNumber'}"
                        unit="{currency}"
                        emphasized="true"
                        class="glanceObjectNumber" />
                </VBox>
                <VBox class="glanceMetricTile">
                    <Text text="{i18n>TOTAL_KPI_PAYOUT}" class="glanceMetricLabel" />
                    <ObjectNumber
                        number="{path: 'totalKPIPayout', formatter: '.formatCleanNumber'}"
                        unit="{currency}"
                        emphasized="true"
                        class="glanceObjectNumber" />
                </VBox>
                <VBox class="glanceMetricTile">
                    <Text text="{i18n>TOTAL_BONUS_YTD}" class="glanceMetricLabel" />
                    <ObjectNumber
                        number="{path: 'totalBonusYTD', formatter: '.formatCleanNumber'}"
                        unit="{currency}"
                        emphasized="true"
                        class="glanceObjectNumber" />
                </VBox>
            </l:Grid>
        </VBox>

        <!-- ===================== KPI DETAILS ===================== -->
        <VBox class="resultsSection kpiDetailsSection" width="100%">
            <VBox class="kpiDetailsHeader" width="100%">
                <Title text="{i18n>MY_KPI_DETAILS}" level="H3" class="kpiDetailsHeaderTitle" />
            </VBox>

            <List
                id="kpiDetailList"
                items="{
                    path: 'to_KPIs',
                    sorter: { path: 'startKpiDate', descending: false }
                }"
                mode="None"
                showSeparators="None"
                class="kpiDetailAccordion">
                <CustomListItem>
                    <Panel
                        expandable="true"
                        expanded="false"
                        expand=".onKpiPanelExpand"
                        width="auto"
                        class="kpiDetailPanel"
                        headerText="{KPIName}">
                        <VBox class="kpiDetailBody">
                            <Text text="{KPIName}" class="kpiCyanBanner" />

                            <l:Grid defaultSpan="XL6 L6 M12 S12" containerQuery="true" class="kpiDetailGrid">
                                <!-- LEFT: calculation flow -->
                                <VBox class="kpiCalcColumn">
                                    <VBox class="kpiFlowCard">
                                        <HBox wrap="Wrap" alignItems="End" class="kpiFlowRow">
                                            <VBox class="kpiFlowFactor sapUiTinyMarginEnd">
                                                <Text text="{path: 'proratedTarget', formatter: '.formatAmountMxp'}" class="kpiFlowValue" />
                                                <Text text="{i18n>PRORATED_TARGET_AMOUNT}" class="kpiFlowLabel" />
                                            </VBox>
                                            <Text text="x" class="kpiFlowOperator" />
                                            <VBox class="kpiFlowFactor sapUiTinyMarginBegin sapUiTinyMarginEnd">
                                                <Text text="{path: 'kpiWeight', formatter: '.formatPercent'}" class="kpiFlowValue" />
                                                <Text text="{i18n>KPI_WEIGHT}" class="kpiFlowLabel" />
                                            </VBox>
                                            <Text text="x" class="kpiFlowOperator" />
                                            <VBox class="kpiFlowFactor sapUiTinyMarginBegin">
                                                <Text text="{path: 'teamWeight', formatter: '.formatPercent'}" class="kpiFlowValue" />
                                                <Text text="{i18n>TEAM_WEIGHT}" class="kpiFlowLabel" />
                                            </VBox>
                                            <Text text="=" class="kpiFlowOperator" />
                                        </HBox>
                                    </VBox>
                                    <HBox justifyContent="Center" class="kpiFlowChevron">
                                        <core:Icon src="sap-icon://slim-arrow-down" class="kpiFlowChevronIcon" />
                                    </HBox>

                                    <VBox class="kpiFlowCard">
                                        <HBox wrap="Wrap" alignItems="End" class="kpiFlowRow">
                                            <VBox class="kpiFlowFactor sapUiTinyMarginEnd">
                                                <Text text="{path: 'kpiTargetAmount', formatter: '.formatAmountMxp'}" class="kpiFlowValue" />
                                                <Text text="{i18n>KPI_TARGET_AMOUNT}" class="kpiFlowLabel" />
                                            </VBox>
                                            <Text text="x" class="kpiFlowOperator" />
                                            <VBox class="kpiFlowFactor sapUiTinyMarginBegin">
                                                <Text text="{path: 'kpiPayoutPercent', formatter: '.formatPercent'}" class="kpiFlowValue" />
                                                <Text text="{i18n>KPI_PAYOUT_PERCENT}" class="kpiFlowLabel" />
                                            </VBox>
                                            <Text text="=" class="kpiFlowOperator" />
                                        </HBox>
                                    </VBox>
                                    <HBox justifyContent="Center" class="kpiFlowChevron">
                                        <core:Icon src="sap-icon://slim-arrow-down" class="kpiFlowChevronIcon" />
                                    </HBox>

                                    <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="kpiFlowResultCard">
                                        <Text text="{i18n>MY_KPI_PAYOUT}" class="kpiFlowResultLabel" />
                                        <Text text="{path: 'kpiPayout', formatter: '.formatAmountMxp'}" class="kpiFlowResultPill" />
                                    </HBox>
                                </VBox>

                                <!-- RIGHT: tier table + payout curve -->
                                <VBox class="kpiRightColumn">
                                    <Table
                                        class="kpiTierTable"
                                        items="{tierRows}"
                                        fixedLayout="false">
                                        <columns>
                                            <Column width="28%"><Text text="" /></Column>
                                            <Column hAlign="End"><Text text="{i18n>KPI_RESULT_MXP}" class="kpiTierHeader" /></Column>
                                            <Column hAlign="End"><Text text="{i18n>PAYOUT_PERCENT_COL}" class="kpiTierHeader" /></Column>
                                            <Column hAlign="End"><Text text="{i18n>AMOUNT_MXP}" class="kpiTierHeader" /></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Text text="{tier}" class="kpiTierName" />
                                                    <Text text="{path: 'kpiResult', formatter: '.formatCleanNumber'}" class="kpiTierCell" />
                                                    <Text text="{path: 'payoutPercent', formatter: '.formatPercent'}" class="kpiTierCell" />
                                                    <HBox justifyContent="End">
                                                        <Text
                                                            text="{path: 'amount', formatter: '.formatCleanNumber'}"
                                                            visible="{= ${highlight} !== 'target' &amp;&amp; ${highlight} !== 'achievement'}"
                                                            class="kpiTierCell" />
                                                        <Text
                                                            text="{path: 'amount', formatter: '.formatCleanNumber'}"
                                                            visible="{= ${highlight} === 'target'}"
                                                            class="kpiTierAmountTarget" />
                                                        <Text
                                                            text="{path: 'amount', formatter: '.formatCleanNumber'}"
                                                            visible="{= ${highlight} === 'achievement'}"
                                                            class="kpiTierAmountAchievement" />
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </VBox>
                            </l:Grid>
                        </VBox>
                    </Panel>
                </CustomListItem>
            </List>

            <VBox class="kpiCurveCard sapUiSmallMarginTop" width="100%" visible="{= !!${/ui/selectedKpiName}}">
                <Title
                    text="{
                        parts: [
                            { path: 'i18n>CHART_PAYOUT_CURVE' },
                            { path: '/ui/selectedKpiName' }
                        ],
                        formatter: '.formatCompareTitle'
                    }"
                    level="H5"
                    class="kpiCurveTitle sapUiTinyMarginBottom" />
                <viz:VizFrame
                    id="kpiPayoutCurve"
                    vizType="line"
                    height="14rem"
                    width="100%"
                    class="kpiPayoutCurve">
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{/ui/selectedKpiCurve}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name="KPI Result" value="{category}" />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition id="payoutCurveMeasure" name="Payout %" value="{payoutPercent}" />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem id="payoutCurveFeed" uid="valueAxis" type="Measure" values="Payout %" />
                        <viz.feeds:FeedItem uid="payoutCurveCategory" type="Dimension" values="KPI Result" />
                    </viz:feeds>
                </viz:VizFrame>
            </VBox>
        </VBox>

        <!-- ===================== QUARTER PROGRESSION ===================== -->
        <VBox class="resultsSection resultsSectionAlt" width="100%">
            <VBox class="sectionHeader">
                <Title text="{i18n>SECTION_QUARTER_PROGRESSION}" level="H3" class="sectionTitle" />
                <Text text="{i18n>QUARTER_PLAN_SUMMARY}" class="sectionSubtitle" />
            </VBox>

            <VBox class="progressChartCard sapUiSmallMarginTop" width="100%">
                <Title text="{i18n>CHART_PROGRESSION_TITLE}" level="H4" class="chartCardTitle sapUiTinyMarginBottom" />
                <viz:VizFrame
                    id="quarterProgressChart"
                    vizType="line"
                    height="18rem"
                    width="100%">
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{/ui/quarterProgressChart}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name="Period" value="{category}" />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition id="segmentAwardMeasure" name="Segment Award" value="{segmentAward}" />
                                <viz.data:MeasureDefinition id="quarterTargetMeasure" name="Quarterly Target" value="{quarterTargetAmount}" />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem id="segmentAwardFeed" uid="valueAxis" type="Measure" values="Segment Award" />
                        <viz.feeds:FeedItem id="quarterTargetFeed" uid="valueAxis" type="Measure" values="Quarterly Target" />
                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Period" />
                    </viz:feeds>
                </viz:VizFrame>
            </VBox>

            <Table
                id="summaryTable"
                items="{
                    path: 'to_qSum',
                    sorter: [
                        { path: 'summaryQuarter', descending: false },
                        { path: 'startQSumDate', descending: false }
                    ]
                }"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                autoPopinMode="true"
                contextualWidth="Auto"
                class="bonusTable sapUiSmallMarginTop">
                <columns>
                    <Column importance="High"><Text text="{i18n>QUARTER}" /></Column>
                    <Column importance="High" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>PERIOD}" /></Column>
                    <Column importance="High"><Text text="{i18n>PLAN_TYPE}" /></Column>
                    <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>BONUSABLE_EARNINGS}" /></Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>QUARTERLY_TARGET_PERCENT}" /></Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>PAYMENT_PERIOD}" /></Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>QUARTERLY_TARGET_AMOUNT}" /></Column>
                    <Column importance="High" hAlign="End"><Text text="{i18n>SEGMENT_AWARD}" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{summaryQuarter}" />
                            <Text text="{
                                path: 'startQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            } to {
                                path: 'endQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            }" />
                            <Text text="{planType}" />
                            <Text text="{path: 'bonusableQuarterEarn', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'quarterTargetPercent', formatter: '.formatPercent'}" />
                            <Text text="{path: 'paymentPeriod', formatter: '.formatPercent'}" />
                            <Text text="{path: 'quarterTargetAmount', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'segmentAward', formatter: '.formatCleanNumber'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <!-- ===================== DISCLAIMERS ===================== -->
        <VBox class="resultsSection disclaimerSection" width="100%">
            <l:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true">
                <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" class="disclaimerText" />
                <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" class="disclaimerText" />
                <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" class="disclaimerText" />
                <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" class="disclaimerText" />
            </l:Grid>
            <MessageStrip
                text="{i18n>NOTE_GCD_BONUS_PRETAX}"
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginTop sapUiMediumMarginBottom" />
        </VBox>
    </VBox>
</mvc:View>
