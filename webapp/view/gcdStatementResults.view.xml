<mvc:View
    controllerName="adobeform.controller.gcdStatementResults"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns="sap.m">

    <VBox id="resultsRoot" width="100%" class="sapUiResponsiveMargin" visible="{/isPdfButtonVisible}">
        <Toolbar>
            <Title text="{VarPayTemplateName}" level="H2" />
            <ToolbarSpacer />
            <Button
                id="generatePdfBtn"
                text="{i18n>GENERATE_PDF}"
                press=".onGeneratePress"
                type="Emphasized"
                visible="{/isPdfButtonVisible}" />
        </Toolbar>

        <HBox wrap="Wrap" justifyContent="SpaceAround" class="sapUiSmallMargin">
            <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                <Label text="{i18n>ELIGIBILITY}" />
                <Text text="{eligibilityPeriod}" />
            </VBox>
            <VBox class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                <Label text="{i18n>QUARTER_AWARD}" />
                <ObjectNumber
                    number="{path: 'totalQuarterAward', formatter: '.formatCleanNumber'}"
                    unit="{currency}"
                    emphasized="true" />
            </VBox>
            <VBox class="sapUiTinyMarginBottom">
                <Label text="{i18n>BONUSABLE_EARNINGS}" />
                <ObjectNumber
                    number="{path: 'bonusableEarnings', formatter: '.formatCleanNumber'}"
                    unit="{currency}"
                    emphasized="true" />
            </VBox>
        </HBox>

        <Panel
            id="summaryPanel"
            expandable="true"
            expanded="true"
            width="auto"
            headerText="{i18n>QUARTER_PLAN_SUMMARY}"
            class="sapUiSmallMarginBottom">
            <Table
                id="summaryTable"
                items="{
                    path: 'to_qSum',
                    sorter: [
                        { path: 'summaryQuarter', descending: false },
                        { path: 'startQSumDate', descending: false }
                    ]
                }"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                autoPopinMode="true"
                contextualWidth="Auto">
                <columns>
                    <Column importance="High">
                        <Text text="{i18n>QUARTER}" />
                    </Column>
                    <Column importance="High" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>PERIOD}" />
                    </Column>
                    <Column importance="High">
                        <Text text="{i18n>PLAN_TYPE}" />
                    </Column>
                    <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>BONUSABLE_EARNINGS}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>QUARTERLY_TARGET_PERCENT}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>PAYMENT_PERIOD}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>QUARTERLY_TARGET_AMOUNT}" />
                    </Column>
                    <Column importance="High" hAlign="End">
                        <Text text="{i18n>SEGMENT_AWARD}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{summaryQuarter}" />
                            <Text text="{
                                path: 'startQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            } to {
                                path: 'endQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            }" />
                            <Text text="{planType}" />
                            <Text text="{path: 'bonusableQuarterEarn', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'quarterTargetPercent', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'paymentPeriod', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'quarterTargetAmount', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'segmentAward', formatter: '.formatCleanNumber'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                <Label text="{i18n>TOTAL_BONUS_YTD}" design="Bold" class="sapUiSmallMarginEnd" />
                <ObjectNumber
                    number="{path: 'totalBonusYTD', formatter: '.formatCleanNumber'}"
                    unit="{currency}"
                    emphasized="true" />
            </HBox>
        </Panel>

        <Panel
            id="kpiPanel"
            expandable="true"
            expanded="true"
            width="auto"
            headerText="{i18n>KPI_DETAILS_CURRENT_Q}"
            class="sapUiSmallMarginBottom">
            <l:Grid defaultSpan="XL6 L6 M12 S12" containerQuery="true" class="sapUiSmallMarginBottom">
                <List
                    id="kpiPayoutList"
                    items="{
                        path: 'to_KPIs',
                        sorter: { path: 'startKpiDate', descending: false }
                    }"
                    headerText="{i18n>MY_KPI_PAYOUT}">
                    <StandardListItem
                        title="{KPIName}"
                        info="{path: 'kpiPayout', formatter: '.formatCleanNumber'}"
                        infoState="Success" />
                </List>
                <viz:VizFrame
                    id="kpiChart"
                    vizType="line"
                    height="16rem"
                    width="100%">
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{
                            path: '/data/to_KPIChart',
                            sorter: { path: 'startKpiDate', descending: false }
                        }">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name="KPI" value="{chartCategory}" />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition id="kpiTargetMeasure" name="KPI Result Target" value="{kpiResTargetValue}" />
                                <viz.data:MeasureDefinition id="kpiAchievementMeasure" name="KPI Result Achievement" value="{kpiResAchievementValue}" />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                        <viz.feeds:FeedItem id="kpiValueFeed" uid="valueAxis" type="Measure" values="KPI Result Target,KPI Result Achievement" />
                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="KPI" />
                    </viz:feeds>
                </viz:VizFrame>
            </l:Grid>

            <Table
                id="kpiTable"
                items="{
                    path: 'to_KPIs',
                    sorter: { path: 'startKpiDate', descending: false }
                }"
                alternateRowColors="true"
                sticky="ColumnHeaders"
                autoPopinMode="true"
                contextualWidth="Auto">
                <columns>
                    <Column importance="High">
                        <Text text="{i18n>QUARTER}" />
                    </Column>
                    <Column importance="High" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>PERIOD}" />
                    </Column>
                    <Column importance="High">
                        <Text text="{i18n>KPI}" />
                    </Column>
                    <Column importance="High" hAlign="End">
                        <Text text="{i18n>KPI_RESULT_TARGET}" />
                    </Column>
                    <Column importance="High" hAlign="End">
                        <Text text="{i18n>KPI_RESULT_ACHIEVEMENT}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>PRORATED_TARGET_AMOUNT}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>KPI_WEIGHT}" />
                    </Column>
                    <Column importance="Low" hAlign="End" minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>TEAM_WEIGHT}" />
                    </Column>
                    <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>KPI_TARGET_AMOUNT}" />
                    </Column>
                    <Column importance="Medium" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                        <Text text="{i18n>KPI_PAYOUT_PERCENT}" />
                    </Column>
                    <Column importance="High" hAlign="End">
                        <Text text="{i18n>MY_KPI_PAYOUT}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{bonusQuarter}" />
                            <Text text="{
                                path: 'startKpiDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            } to {
                                path: 'endKpiDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            }" />
                            <Text text="{KPIName}" />
                            <ObjectStatus text="{path: 'kpiResTarget', formatter: '.formatCleanNumber'}" state="Success" />
                            <ObjectStatus text="{path: 'kpiResAchievement', formatter: '.formatCleanNumber'}" state="Success" />
                            <Text text="{path: 'proratedTarget', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'kpiWeight', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'teamWeight', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'kpiTargetAmount', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'kpiPayoutPercent', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'kpiPayout', formatter: '.formatCleanNumber'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <HBox justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                <Label text="{i18n>TOTAL_KPI_PAYOUT}" design="Bold" class="sapUiSmallMarginEnd" />
                <ObjectNumber
                    number="{path: 'totalKPIPayout', formatter: '.formatCleanNumber'}"
                    unit="{currency}"
                    emphasized="true" />
            </HBox>
        </Panel>

        <l:Grid defaultSpan="XL3 L3 M6 S12" containerQuery="true" class="sapUiSmallMarginTop">
            <FormattedText htmlText="{i18n>CALCULATION_BASIS_HTML}" />
            <FormattedText htmlText="{i18n>ELIGIBILITY_PRORATION_HTML}" />
            <FormattedText htmlText="{i18n>PAYMENT_INFORMATION_HTML}" />
            <FormattedText htmlText="{i18n>OFFICIAL_POLICY_DISCLAIMER_HTML}" />
        </l:Grid>
        <MessageStrip
            text="{i18n>NOTE_GCD_BONUS_PRETAX}"
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginTop sapUiMediumMarginBottom" />
    </VBox>
</mvc:View>
