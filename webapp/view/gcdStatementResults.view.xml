<mvc:View
    controllerName="adobeform.controller.gcdStatementResults"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns="sap.m">

    <VBox id="resultsRoot" width="100%" class="resultsShell">

        <!-- At a glance -->
        <VBox class="glanceHero sapUiContentPadding" width="100%">
            <HBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Start" width="100%">
                <VBox>
                    <Title text="{VarPayTemplateName}" level="H1" titleStyle="H1" class="glanceTitle" />
                    <Text text="{i18n>ELIGIBILITY}: {eligibilityPeriod}" class="sapUiTinyMarginTop" />
                </VBox>
                <Button
                    id="generatePdfBtn"
                    text="{i18n>GENERATE_PDF}"
                    press=".onGeneratePress"
                    type="Emphasized"
                    visible="{/isPdfButtonVisible}" />
            </HBox>

            <VBox alignItems="Center" width="100%" class="sapUiSmallMarginTop glanceAwardBlock">
                <Text text="{i18n>PERIOD_TOTAL}" class="periodTotalLabel" />
                <ObjectNumber
                    class="glanceAward"
                    number="{path: 'totalQuarterAward', formatter: '.formatCleanNumber'}"
                    unit="{currency}" />
            </VBox>

            <HBox wrap="Wrap" justifyContent="Center" width="100%" class="sapUiMediumMarginTop">
                <HBox class="sapUiTinyMarginBottom sapUiSmallMarginEnd">
                    <VBox class="kpiLabelBox" justifyContent="Center">
                        <Label text="{i18n>BONUSABLE_EARNINGS}" />
                    </VBox>
                    <VBox class="kpiValueBox" justifyContent="Center">
                        <ObjectNumber
                            class="metricBoxNumber"
                            number="{path: 'bonusableEarnings', formatter: '.formatCleanNumber'}"
                            unit="{currency}" />
                    </VBox>
                </HBox>
                <HBox class="sapUiTinyMarginBottom">
                    <VBox class="kpiLabelBox" justifyContent="Center">
                        <Label text="{i18n>TOTAL_BONUS_YTD}" />
                    </VBox>
                    <VBox class="kpiValueBox" justifyContent="Center">
                        <ObjectNumber
                            class="metricBoxNumber"
                            number="{path: 'totalBonusYTD', formatter: '.formatCleanNumber'}"
                            unit="{currency}" />
                    </VBox>
                </HBox>
            </HBox>
        </VBox>

        <!-- KPI DETAILS -->
        <Panel
            width="auto"
            class="themePanel kpiDetailsPanel sapUiSmallMarginTop"
            headerText="{i18n>MY_KPI_DETAILS}">

            <List
                id="kpiDetailList"
                items="{
                    path: 'to_KPIs',
                    sorter: { path: 'startKpiDate', descending: false }
                }"
                mode="None"
                showSeparators="None"
                class="kpiDetailList">
                <CustomListItem>
                    <Panel
                        expandable="true"
                        expanded="false"
                        expand=".onKpiPanelExpand"
                        width="auto"
                        class="kpiDetailPanel sapUiSmallMarginBottom">
                        <headerToolbar>
                            <OverflowToolbar class="kpiDetailHeaderBar">
                                <Title text="{KPIName}" level="H5" class="kpiDetailHeaderTitle" />
                                <ToolbarSpacer />
                                <Text text="{
                                    path: 'startKpiDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                                } – {
                                    path: 'endKpiDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                                }" class="kpiDetailHeaderPeriod" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiSmallMargin">

                            <VBox>
                                <Title text="{i18n>KPI_BREAKDOWN}" level="H5" class="sapUiTinyMarginBottom" />

                                <HBox wrap="Wrap" alignItems="Center" justifyContent="SpaceAround" class="kpiFlowCard sapUiContentPadding sapUiSmallMarginBottom">
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <ObjectNumber class="kpiFlowNumber" number="{path: 'proratedTarget', formatter: '.formatCleanNumber'}" unit="{/data/currency}" />
                                        <Label text="{i18n>PRORATED_TARGET_AMOUNT}" class="sapUiTinyMarginTop kpiFlowLabel" />
                                    </VBox>
                                    <Title text="×" level="H3" class="kpiFlowOp" />
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{path: 'kpiWeight', formatter: '.formatPercent'}" level="H3" class="kpiFlowNumber" />
                                        <Label text="{i18n>KPI_WEIGHT}" class="sapUiTinyMarginTop kpiFlowLabel" />
                                    </VBox>
                                    <Title text="×" level="H3" class="kpiFlowOp" />
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{path: 'teamWeight', formatter: '.formatPercent'}" level="H3" class="kpiFlowNumber" />
                                        <Label text="{i18n>TEAM_WEIGHT}" class="sapUiTinyMarginTop kpiFlowLabel" />
                                    </VBox>
                                </HBox>

                                <HBox justifyContent="Center" class="sapUiTinyMargin">
                                    <core:Icon src="sap-icon://slim-arrow-down" class="kpiChevron" />
                                </HBox>

                                <HBox wrap="Wrap" alignItems="Center" justifyContent="SpaceAround" class="kpiFlowCard sapUiContentPadding sapUiSmallMarginBottom">
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <ObjectNumber class="kpiFlowNumber" number="{path: 'kpiTargetAmount', formatter: '.formatCleanNumber'}" unit="{/data/currency}" />
                                        <Label text="{i18n>KPI_TARGET_AMOUNT}" class="sapUiTinyMarginTop kpiFlowLabel" />
                                    </VBox>
                                    <Title text="×" level="H3" class="kpiFlowOp" />
                                    <VBox alignItems="Center" class="sapUiTinyMargin">
                                        <Title text="{path: 'kpiPayoutPercent', formatter: '.formatPercent'}" level="H3" class="kpiFlowNumber" />
                                        <Label text="{i18n>KPI_PAYOUT_PERCENT}" class="sapUiTinyMarginTop kpiFlowLabel" />
                                    </VBox>
                                </HBox>

                                <HBox justifyContent="Center" class="sapUiTinyMargin">
                                    <core:Icon src="sap-icon://slim-arrow-down" class="kpiChevron" />
                                </HBox>

                                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="kpiFlowResult sapUiContentPadding">
                                    <Label text="{i18n>MY_KPI_PAYOUT}" design="Bold" class="kpiPayoutLabel" />
                                    <ObjectNumber
                                        class="kpiPayoutAmount"
                                        number="{path: 'kpiPayout', formatter: '.formatCleanNumber'}"
                                        unit="{/data/currency}"
                                        />
                                </HBox>
                            </VBox>

                            <VBox>
                                <Title text="{i18n>CHART_KPI_COMPARE}" level="H5" class="sapUiTinyMarginBottom" />
                                <Table
                                    mode="None"
                                    showSeparators="Inner"
                                    backgroundDesign="Transparent"
                                    class="themeTable"
                                    items="{
                                        path: 'tierRows',
                                        templateShareable: false
                                    }">
                                    <columns>
                                        <Column width="28%"><Text text="" /></Column>
                                        <Column hAlign="End"><Text text="{i18n>KPI_RESULT}" /></Column>
                                        <Column hAlign="End"><Text text="{i18n>PAYOUT_PERCENT_COL}" /></Column>
                                        <Column hAlign="End"><Text text="{i18n>AMOUNT}" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{tier}" class="kpiTierText" />
                                                <Text text="{path: 'kpiResult', formatter: '.formatCleanNumber'}" class="kpiTierText" />
                                                <Text text="{path: 'payoutPercent', formatter: '.formatPercent'}" class="kpiTierText" />
                                                <Text text="{path: 'amount', formatter: '.formatCleanNumber'}" class="kpiTierAmount" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>

                                <VBox class="sapUiMediumMarginTop" width="100%">
                                    <Title text="{i18n>CHART_PAYOUT_CURVE}" level="H5" class="sapUiTinyMarginBottom" />
                                    <viz:VizFrame
                                        vizType="line"
                                        height="14rem"
                                        width="100%">
                                        <viz:dataset>
                                            <viz.data:FlattenedDataset data="{
                                                path: 'payoutCurve',
                                                templateShareable: false
                                            }">
                                                <viz.data:dimensions>
                                                    <viz.data:DimensionDefinition name="KPI Result" value="{category}" />
                                                </viz.data:dimensions>
                                                <viz.data:measures>
                                                    <viz.data:MeasureDefinition name="Payout %" value="{payoutPercent}" />
                                                </viz.data:measures>
                                            </viz.data:FlattenedDataset>
                                        </viz:dataset>
                                        <viz:feeds>
                                            <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Payout %" />
                                            <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="KPI Result" />
                                        </viz:feeds>
                                    </viz:VizFrame>
                                </VBox>
                            </VBox>
                        </l:Grid>
                    </Panel>
                </CustomListItem>
            </List>
        </Panel>

        <!-- QUARTER SUMMARY -->
        <Panel
            width="auto"
            class="themePanel quarterSummaryPanel sapUiSmallMarginTop"
            headerText="{i18n>QUARTER_PLAN_SUMMARY}">

            <Table
                id="summaryTable"
                items="{
                    path: 'to_qSum',
                    sorter: [
                        { path: 'summaryQuarter', descending: false },
                        { path: 'startQSumDate', descending: false }
                    ]
                }"
                alternateRowColors="false"
                sticky="ColumnHeaders"
                backgroundDesign="Transparent"
                class="themeTable sapUiTinyMargin">
                <columns>
                    <Column width="9%"><Text text="{i18n>QUARTER}" /></Column>
                    <Column width="16%"><Text text="{i18n>PERIOD}" /></Column>
                    <Column width="13%"><Text text="{i18n>PLAN_TYPE}" /></Column>
                    <Column width="14%" hAlign="End"><Text text="{i18n>BONUSABLE_EARNINGS}" /></Column>
                    <Column width="12%" hAlign="End"><Text text="{i18n>QUARTERLY_TARGET_PERCENT}" /></Column>
                    <Column width="12%" hAlign="End"><Text text="{i18n>PAYMENT_PERIOD}" /></Column>
                    <Column width="12%" hAlign="End"><Text text="{i18n>QUARTERLY_TARGET_AMOUNT}" /></Column>
                    <Column width="12%" hAlign="End"><Text text="{i18n>SEGMENT_AWARD}" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{summaryQuarter}" />
                            <Text text="{
                                path: 'startQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            } to {
                                path: 'endQSumDate',
                                type: 'sap.ui.model.type.Date',
                                formatOptions: { source: {pattern: 'yyyyMMdd'}, pattern: 'MMM dd' }
                            }" />
                            <Text text="{planType}" />
                            <Text text="{path: 'bonusableQuarterEarn', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'quarterTargetPercent', formatter: '.formatPercent'}" />
                            <Text text="{path: 'paymentPeriod', formatter: '.formatPercent'}" />
                            <Text text="{path: 'quarterTargetAmount', formatter: '.formatCleanNumber'}" />
                            <Text text="{path: 'segmentAward', formatter: '.formatCleanNumber'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>

    </VBox>
</mvc:View>
